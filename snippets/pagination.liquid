{%- if paginate.parts.size > 0 -%}
  <div class="pagination-wrapper {{ class }}">
    <nav class="pt-3 pt-lg-5" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
      <ul class="pagination pagination__list list-unstyled mb-0" role="list">
        {%- if paginate.previous -%}
          <li class="page-item">
            <a
              href="{{ paginate.previous.url }}{{ anchor }}"
              class="pagination__item--next"
              aria-label="{{ 'general.pagination.previous' | t }}"
              data-link-target="{{ paginate.current_page | minus: 1 }}"
            >
              {% render 'left-arrow' %}
            </a>
          </li>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          <li class="page-item">
            {%- if part.is_link -%}
              <a
                href="{{ part.url }}{{ anchor }}"
                class="pagination__item"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                data-link-target="{{ part.title }}"
              >
                {% if part.title < 10 %}0{% endif %}{{- part.title -}}
              </a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <a
                  role="link"
                  aria-disabled="true"
                  class="pagination__item pagination__item--current light active"
                  aria-current="page"
                  aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                  data-link-target="{{ paginate.current_page | plus: 1 }}"
                >
                 {% if part.title < 10 %}0{% endif %}{{- part.title -}}
                </a>
              {%- else -%}
                <span class="pagination__item">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}

        {%- if paginate.next -%}
          <li class="page-item">
            <a
              href="{{ paginate.next.url }}{{ anchor }}"
              class="pagination__item pagination__item--prev"
              aria-label="{{ 'general.pagination.next' | t }}"
              data-link-target="{{ paginate.current_page | plus: 1 }}"
            >
              {%- render 'right-arrow' -%}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
{%- endif -%}
