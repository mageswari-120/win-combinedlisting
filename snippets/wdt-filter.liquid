                                price_class: '',
                                show_compare_at_price: true,
                                text_align: text_alignment,
                                class: 'mt-2'
                              %}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

