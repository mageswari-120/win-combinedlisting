{% assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id %}
{%- if card_product and card_product != blank -%}
  <div class="card-wrapper product-card-wrapper">
    <div class="card-main card color-{{ card_background }} gradient">
      <div
        class="
          card__inner position-relative ratio
          {% case media_aspect_ratio -%}
                 {%- when 'square' -%}
                   ratio-1x1
                 {%- when 'portrait' -%}
                   ratio-3x4
                 {%- when 'adapt' -%}
                   ratio-auto
                 {%- else -%}
                   ratio-1x1
               {%- endcase -%}
        "
        {% if card_product.featured_media.aspect_ratio == null %}
          style=" --aspect-ratio:100%"
        {% else %}
          style=" --aspect-ratio:{%- if card_product.featured_media -%}{{ 1 | divided_by: card_product.featured_media.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};"
        {% endif %}
      >
        <div class="card__inner_wrapper">
          {%- if card_product.featured_media -%}
            <a href="{{ card_product.url }}" class="card--image product_media position-absolute w-100 h-100 border-style spacing-style overflow-hidden z-1">
              {{
                card_product.featured_media
                | image_url: width: 1280
                | image_tag:
                  loading: 'lazy',
                  width: card_product.featured_media.width,
                  height: card_product.featured_media.height,
                  sizes: '(min-width: 1200px) 600px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
                  widths: '540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                  class: 'motion-reduce featured-media',
                  alt: card_product.featured_media.alt
                | escape
              }}

              {%- if card_product.media[1] != null and show_secondary_image -%}
                <span class="card-secondary-image overflow-hidden position-absolute start-0 end-0 w-100 h-100">
                  {{
                    card_product.media[1]
                    | image_url: width: 1280
                    | image_tag:
                      alt: card_product.media[1].alt,
                      aria_hidden: 'true',
                      loading: 'lazy',
                      width: card_product.media[1].width,
                      height: card_product.media[1].height,
                      sizes: '(min-width: 1200px) 600px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
                      widths: '540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                      class: 'motion-reduce'
                    | escape
                  }}
                </span>
              {%- endif -%}
            </a>
          {% else %}
             <img
          src="{{ 'product_placeholder.jpg' | asset_url }}"
          class="placeholder h-100 w-100"
          alt="product_placeholder"
        >
          {%- endif -%}
        </div>
        <div class="card_content">
          {% if settings.show_new_badge %}
          <div class="card-information new--tag">                    
          {% for tag in card_product.tags %}  
          {% assign tag = tag | handleize  %}              
          {% if tag contains 'Tag_New' %}
          <span class="badge badge--new product_new_badge mb-1"
          style="border-radius:{{ settings.badge_radius }}px; text-transform:{{ settings.badge_testcase }};" >
          <span class="badge__text">{{ 'products.product.new' | t }}</span> 
          </span>
          {% endif %}
          {% endfor %}   
          </div>
          {% endif %}
          <div class="card__badge">
            {%- if card_product.available == false and settings.show_soldout_badge-%}
              <span
              id="Badge-{{ section_id }}-{{ card_product.id }}"
              class="badge badge--bottom-left h6 sold_out_badge product_badge_sale"
              style="border-radius:{{ settings.badge_radius }}px; text-transform:{{ settings.badge_testcase }};" 
              >
              {{- 'products.product.sold_out' | t -}}
              </span>
            {%- elsif card_product.compare_at_price > card_product.price and card_product.available and settings.show_sale_badge -%}
              <span
              id="Badge-{{ section_id }}-{{ card_product.id }}"
              class="badge badge--bottom-left sale_badge product_badge_sale  "
              style="border-radius:{{ settings.badge_radius }}px; text-transform:{{ settings.badge_testcase }};"  
              >
              {{- 'products.product.on_sale' | t -}}
              </span>
            {%- endif -%}
          </div>

          {% if show_quick_button %}
            <div
              class="quick-add no-js-hidden product-varient {% if card_product.variants.size == 1 %} quick_addtocart {% endif %}"
              tabindex="-1"
            >
              {%- if card_product.variants.size == 1 -%}
                <add-to-cart-form data-section-id="{{ section.id }}">
                  {%- form 'product',
                    card_product,
                    id: product_form_id,
                    class: 'form',
                    novalidate: 'novalidate',
                    data-type: 'add-to-cart-form'
                  -%}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ card_product.selected_or_first_available_variant.id }}"
                      class="product-variant-id"
                      {% if card_product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                      data-inventory-quantity="{{ card_product.selected_or_first_available_variant.inventory_quantity }}"
                      data-inventory-management="{{ card_product.selected_or_first_available_variant.inventory_management }}"
                      data-inventory-policy="{{ card_product.selected_or_first_available_variant.inventory_policy }}"
                    >

                    <button
                      id="{{ product_form_id }}-submit"
                      type="button"
                      name="add"
                      class="quick-add__submit quick-view-btn"
                      aria-haspopup="dialog"
                      aria-label="{{ product_form_id }}-submit"
                      aria-live="polite"
                      {% if card_product.selected_or_first_available_variant.available == false %}
                        data-sold-out-message="true"
                        disabled
                      {% endif %}
                    >
                      <span>
                        {%- if card_product.selected_or_first_available_variant.available -%}
                          {% render 'cart-icon' %}
                        {%- else -%}
                          {% render 'soldout-icon' %}
                        {%- endif -%}
                      </span>
                      <span class="sold-out-message visually-hidden">
                        {% render 'soldout-icon' %}
                      </span>
                    </button>
                  {%- endform -%}
                </add-to-cart-form>
              {% endif %}
              {% if card_product.variants.size > 1 %}
                <button
                  type="button"
                  class="quick-view-btn"
                  data-product-url="{{ card_product.url | split: "?" | first }}"
                  aria-label="quick-buy-{{ product_form_id }}"
                  title="quick buy"
                >
                  {% render 'icon-zoom' %}
                </button>
              {% endif %}
            </div>
          {%- endif -%}
          {%- if show_compare or show_wishlist -%}
            <div class="product-icons card-img-overlay p-0 m-3">
              <ul class="product-icons_wrapper list-unstyled">
                {%- if show_compare -%}
                  <li>
                    <dtx-compare
                      ><a
                        role="link"
                        aria-label="{{ 'products.compare.add_to_compare' | t }}"
                        class="add-compare"
                        data-product_handle="{{ card_product.handle }}"
                      >
                      </a>
                      <tooltip class="tooltip"></tooltip>
                    </dtx-compare>
                  </li>
                {%- endif -%}

                {%- if show_wishlist -%}
                  <li>
                    <dtx-wishlist class="position-relative d-flex">
                      {%- render 'button-wishlist', product: card_product -%}
                    </dtx-wishlist>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
      <div class="card-body text-{{ alignment }}">
        <div class="card-body-information">
          {%- if show_vendor -%}
            <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
            <div class="card-subtitle mb-1 text-wrap">{{ card_product.vendor }}</div>
          {%- endif -%}

          <h3 class="card-title h4" id="title-{{ section_id }}-{{ card_product.id }}">
            <a
              href="{{ card_product.url }}"
              id="CardLink-{{ section_id }}-{{ card_product.id }}"
              aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }}"
            >
              {{ card_product.title | escape }}
            </a>
          </h3>
          {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
          {%- if show_description -%}
            <div class="card-description rte">{{ card_product.description | strip_html | truncate: 90 }}</div>
          {%- endif -%}
          {% if swatch_color and card_product.media.size > 0 %}
            {% render 'card-swatch',
              product: card_product,
              alignment: alignment,
              show_variant_image: show_variant_image
            %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper product-card-wrapper">
    <div class="card card-main   color-{{ card_background }} gradient  overflow-hidden">
      <div class="card__inner position-relative ratio ratio-1x1  color-{{ card_background }} gradient ">
        <div class="card__inner_wrapper">
          {%- if placeholder_image -%}
            {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg rounded' }}
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg rounded' }}
          {% endif %}
        </div>
      </div>
      <div class="card-body text-{{ alignment }} ">
        <div class="card-body-information">
          <h3 class="card-title h4" id="title-{{ section_id }}-{{ card_product.id }}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.product_title' | t }}
            </a>
          </h3>
          <div class="placeholder-price">{{ 0.00 | money }}</div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
