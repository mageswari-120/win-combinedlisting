{% if product.available %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    assign product_form_id = 'product-form-' | append: section.id
    assign image = current_variant.image | default: product.featured_image
  %}
  <style>

    :root{
      --box-shadow:#000 0 6px 12px -2px,#0000004d 0 3px 7px -3px;
    }

    @media (max-width: 780px) {
      #sticky-atc-bar.show{visibility:hidden; opacity:0;}
    }
    /* #sticky-atc-bar .product-deatils .sticky-product-price, #sticky-atc-bar .product--information button{ font-size: var(--bs-body-font-size) ;  font-weight: var(--font-body-weight-bold);} */

      #sticky-atc-bar {
      opacity: 1;
      transition: opacity 0.5s ease;
      /* box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px; */
         box-shadow: var(--bs-box-shadow);
    }

    #sticky-atc-bar.show {
      opacity: 1;
      width:75%;
      box-shadow: var(--box-shadow);
    }

    #sticky-atc-bar:not(.show) {
      opacity: 0;
      pointer-events: none;
    }
    #sticky-atc-bar :is(.cart-image){
      width:100px;
      height:100px;
      border-radius: var(--bs-border-radius-lg);
      overflow: hidden;
      border: var(--bs-border-width) var(--bs-border-style) rgb(var(--bs-border-color)) !important;
    }
    @media (max-width: 576px) {
      #sticky-atc-bar.show{display:none;}
      }
    #sticky-atc-bar .product-deatils { width: calc(100% - 32%);}
    #sticky-atc-bar .btn-close{ width:12px; height:12px; }
  </style>
  <sticky-cart-form>
    <div id="sticky-atc-bar" class="color-{{ settings.offcanvas_color_scheme }} gradient rounded-4 m-3 mx-auto" {{ shopify_attribute }}>
      <div class="close m-2 position-absolute top-0 end-0 shadow-none" id="close-sticky-bar">
        <button type="button" class="btn-close m-0" aria-label="Close">{% render 'cancel.svg' %}</button>
      </div>
      <div class="product--information">
        <div class="sticky_container d-flex flex-wrap justify-content-evenly align-items-center gap-3">
          <div class="d-flex align-items-center flex-wrap gap-3">
            {% if image != blank %}
              <div class="cart-image">
                {{
                  image
                  | image_url: width: 350
                  | image_tag: class: 'sticky-product-image w-100 h-100 object-fit-cover', alt: product.title
                }}
              </div>
            {% endif %}
          
            <div class="product_title">
              <h5 class="mb-2">{{ product.title }}</h5>
              <p id="sticky-product-price" class="mb-2 sticky-product-price fw-bold">
                {{ current_variant.price | money }}
              </p>
            </div>
          </div>

            <form method="post" action="{{ routes.cart_add_url }}" id="{{ product_form_id }}">
               <quantity-editor {{ block.shopify_attributes }}>
                <div class="d-grid gap-3 h-100">
                  
                  <div class="quantity mb-0{% if section.settings.nav_style == 'modern' %} bg-transparent{% endif %}">
                    <button class="decrement-btn quantity__button" aria-label="decrement">
                      {% render 'icon-toggle-minus' %}
                    </button>
                    <input
                      type="number"
                      name="quantity"
                      class="form-control quantity-input"
                      value="1"
                      min="1"
                      {% if selected_variant.inventory_management != blank %}
                        max="{{ selected_variant.inventory_quantity }}"
                        data-max="{{ selected_variant.inventory_quantity }}"
                      {% endif %}
                      id="quantity-{{ section.id }}"
                    >
                    <button class="increment-btn quantity__button" aria-label="increment">
                      {% render 'icon-toggle-plus' %}
                    </button>
                  </div>
                </div>
              </quantity-editor>


              {% if product.has_only_default_variant == false %} 
                <select name="id" class="form-select stickySelect w-100 btn btn-secondary" aria-label="Select variant">
                  {% for variant in product.variants %}
                    {% assign variant_image = variant.image | default: product.featured_image %}
                    <option
                      value="{{ variant.id }}"
                      data-img="{{ variant_image | image_url: width: 100 }}"
                      data-price="{{ variant.price }}"
                      {% if variant.id == current_variant.id %}
                        selected
                      {% endif %}
                      {% unless variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {{ variant.title }}
                    </option>
                  {% endfor %}
                </select>
              {% endif %}
            </form>

            <button type="button" name="add" class="btn btn-primary">
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
        
        </div>
      </div>
    </div>
  </sticky-cart-form>
  <script>
    function initializeStickyAtcBar() {
      const stickyAtcBar = document.querySelector('#sticky-atc-bar');
      if (!stickyAtcBar) return;

      const variantSelect = stickyAtcBar.querySelector("select[name='id']");
      const primaryVariantSelect = document.querySelector("input[name='id']");
      const productImage = stickyAtcBar.querySelector('.sticky-product-image');
      const productPrice = stickyAtcBar.querySelector('.sticky-product-price');
      const addToCartButton = stickyAtcBar.querySelector("button[name='add']");
      const pageAddToCartButton = document.querySelector("button[name='add']");
      const closeButton = document.querySelector('#close-sticky-bar');

      if (!pageAddToCartButton) return;

      let threshold = pageAddToCartButton.getBoundingClientRect().bottom + window.pageYOffset;

      // Show/hide Sticky ATC bar on scroll
      function toggleStickyBar() {
        if (window.scrollY > threshold) {
          stickyAtcBar.classList.add('show');
        } else {
          stickyAtcBar.classList.remove('show');
        }
      }

      // Update threshold on resize
      function updateThreshold() {
        threshold = pageAddToCartButton.getBoundingClientRect().bottom + window.pageYOffset;
      }

      window.addEventListener('scroll', toggleStickyBar);
      window.addEventListener('resize', updateThreshold);

      // Close button functionality
      if (closeButton) {
        closeButton.addEventListener('click', function () {
          stickyAtcBar.style.transition = 'opacity 0.5s ease';
          stickyAtcBar.style.opacity = '0';
          setTimeout(() => {
            stickyAtcBar.style.display = 'none';
          }, 500); // Match the duration of the fade-out effect
        });
      }

      // Update product image, price, and variant ID on variant selection
      if (variantSelect) {
        variantSelect.addEventListener('change', function () {
          const selectedOption = variantSelect.options[variantSelect.selectedIndex];
          const newImageUrl = selectedOption.dataset.img;
          const newPrice = selectedOption.dataset.price;
          const stickyVariantID = selectedOption.value;
          if (!productImage) return;
          if (newImageUrl) {
            productImage.src = newImageUrl;
            productImage.srcset = newImageUrl;
          }

          if (newPrice) {
            productPrice.textContent = Shopify.formatMoney(newPrice, wdtTheme.moneyFormat);
          }

          // Update the primary variant ID input
          if (primaryVariantSelect) {
            primaryVariantSelect.value = stickyVariantID;
          }
        });
      }

      // Sync Add to Cart button
      if (addToCartButton) {
        addToCartButton.addEventListener('click', function () {
          document.querySelector('#addToCart').click();
        });
      }
    }

    // Initialize sticky ATC bar on DOMContentLoaded
    document.addEventListener('DOMContentLoaded', initializeStickyAtcBar);
  </script>
{% endif %}
