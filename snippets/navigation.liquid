{%- assign dt_mega = false -%}
{%- for block in section.blocks -%}
  {% for i in (1..5) %}
    {%- assign megamenu_title = '' -%}
    {%- assign link_title = link.title | escape | strip | handleize -%}
    {%- assign dt_menu_pick = i | prepend: 'mega_' -%}
    {% if block.settings[dt_menu_pick] != blank %}
      {% assign megamenu_title = block.settings[dt_menu_pick] | handleize %}
      {%- if link_title == megamenu_title -%}        
        {% assign promo_banner_style = block.settings.banner_style %}
        {% assign tab_style = block.settings['tab-menu'] -%}
        {% assign block_type = block.type %}
        {% assign block_id = block.id %}
        {%- assign dt_mega = true -%}        
        {%- capture mega_banner_primary -%}
          {% render 'dt-megaBanner-1', block: block %}
        {%- endcapture -%}
        {%- capture mega_banner_secondary -%}
          {% render 'dt-megaBanner-2', block: block %}
        {%- endcapture -%}
        {%- capture mega_colllist -%}
          {% render 'dt-megaCollList', block: block %}
        {%- endcapture -%}
        {% if block_type == 'promo_banner' or 'menu_with_banner' %}
           {%- if link.links != blank  -%}
             {%- capture mega_banner_menu -%}
                {% render 'mega-nav-loop', link: link %}
             {%- endcapture -%}
           {% endif %}
        {% endif %}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- liquid
  if block_type == 'megaProduct'
    assign block_type_cls = 'megaProduct'
  elsif block_type == 'promo_banner'
    assign block_type_cls = 'promo_banner'
  else
    assign block_type_cls = 'text-menu'
  endif
%}
<li class="nav-item text-wrap  {% unless dt_mega %} position-relative{% endunless %} {{ block_type_cls }}{% if dt_mega %} has-mega-menu{% endif %}{% if link.active %} active{% endif %}">
  {% if dt_mega %}
    <div class="{% if dt_mega %}mega-menu__wrapper{% endif %}">
      <a
        href="{{ link.url }}"
        class="nav-link {{ font_style }} {% if link.active %}active{% endif %} {% if link.links != blank or mega_banner_primary !=blank or mega_banner_secondary !=blank %}dropdown-toggle{% endif %}"
        role="button"
        data-bs-toggle="dropdown"
        data-bs-auto-close="outside"
         aria-expanded="false" 
         tabindex="0"
      >
        {% assign main_tag = link.handle %}
        {% if sale_tag contains main_tag %}
          <em class="sale tag">{{ sale_label }}</em>
        {% elsif new_tag contains main_tag %}
          <em class="new tag">{{ new_label }}</em>
        {% elsif hot_tag contains main_tag %}
          <em class="hot tag">{{ hot_label }}</em>
        {% endif %}
        <span data-hover="{{ link.title | escape }}">
          {{ link.title | escape }}
        </span>
        {% if dt_mega -%}
          {% comment %} <span class="dt-sc-caret"> {% render 'arrow-svg' %}</span> {% endcomment %}
        {% endif %}
      </a>
      <div class="dropdown-menu sub-menu-block block-{{ block_id }}-type mega-menu__content position-absolute start-0 end-0 border-top">
        <div class="dt-sc-dropdown-menu{% if dt_mega %} dt-sc--main-menu--mega d-flex justify-content-center container container-custom {% endif %}">
            <ul class="block_type-{{ block_type }} sub-menu-lists list-unstyled row position-relative my-5 mx-0
              {% if dt_mega %}{{ tab_style }}{% endif %}   {% if block_type == 'menu_with_banner' %} row row-cols-3  row-cols-xl-3  row-gap-2 justify-content-xl-between {% endif %}
              {% if mega_banner_menu %}w-100{% else %}w-100{% endif %}
              "
            >
              {%- liquid
                if promo_banner_style == 'both_edges'
                  assign cols_a = 'order-1'
                  assign cols_b = 'order-2'
                  assign cols_c = 'order-3'
                elsif promo_banner_style == 'left'
                  assign cols_a = 'order-1'
                  assign cols_b = 'order-3'
                  assign cols_c = 'order-2'
                else
                  assign cols_a = 'order-2'
                  assign cols_b = 'order-1'
                  assign cols_c = 'order-3'
                endif
              %}
              {% if block_type == 'promo_banner' %}             
                   {%- if mega_banner_primary != blank -%}
                    <li class="{% if mega_banner_menu != blank %}col-3{% else %}col-3{% endif %} {{ cols_a }} ps-3 pe-0">
                      <ul class="list-unstyled  row-cols-1 col-12  {% if promo_banner_style == 'both_edges' %} pe-4 pe-xxl-5 ps-0 {% else %} ps-4 ps-xxl-5 pe-0 {% endif %}">
                        {{ mega_banner_primary }}
                      </ul>
                    </li>                 
                {% endif %}

                {%- if link.links != blank  -%}
                  <li class="{% if mega_banner_primary != blank and mega_banner_secondary != blank %}col-6{% elsif mega_banner_primary  != blank or mega_banner_secondary  != blank %}col-9{% else %}col-12{% endif %} {{ cols_b }} p-0">
                    {{ mega_banner_menu }}
                  </li>
                {% endif %}

                  {%- if mega_banner_secondary != blank -%}
                    <li class="{% if mega_banner_menu != blank %}col-3{% else %}col-3{% endif %} {{ cols_c }} pe-3 ps-0">
                      <ul class="list-unstyled  row-cols-1 col-12 ps-4 ps-xxl-5 pe-0">
                        {{ mega_banner_secondary }}                       
                      </ul>
                    </li>
                  {% endif %}              
              {% endif %}

              {% if block_type == 'menu_with_banner' %}
                      {%- for childlink in link.links -%}
                        <li class="{% if menu_type != 'megamenu' %}mt-4{% endif %} col text-break {% if childlink.current %} active{% endif %}">
                          <a href="{{ childlink.url }}" class="text-decoration-none  h5 {% if childlink.current %} active {% endif %}" aria-label=" {{ childlink.title | escape }}">
                            {{ childlink.title | escape }}
                          </a>
                          {%- if childlink.links != blank -%}
                            <ul class="list-unstyled">
                              {%- for grandchildlink in childlink.links -%}
                                <li class="{% if grandchildlink.current %} active {% endif %}submenu-item my-3">
                                  <a href="{{ grandchildlink.url }}" class="text-decoration-none text-reset {% if grandchildlink.current %} active {% endif %}" aria-label="{{ grandchildlink.title | escape }}">
                                    {{ grandchildlink.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                      </li>
                      {%- endfor -%}

                  {{ mega_colllist }}
              {% endif %}
            </ul>
        </div>
      </div>
    </div>
  {% else %}
    <a
      href="{{ link.url }}"
      class="nav-link {{ font_style }} {% if link.active %} active{% endif %} {% if link.links != blank %} dropdown-toggle{% endif %}"
      role="button"
      {% if link.links != blank %}
        data-bs-toggle="dropdown"
        data-bs-auto-close="outside"
        aria-expanded="false"
      {% endif %}
    >
      {{ link.title | escape }}
     {% comment %} {% if link.links != blank %}    <span class="dt-sc-caret"> {% render 'arrow-svg' %}</span>  {% endif %} {% endcomment %}
    </a>
    {%- if link.links != blank -%}
      <ul class="dropdown-menu sub-menu border-top submenu-list">
        {%- for child_link in link.links -%}
          <li class="dropdown dropend menu-item {% if child_link.current %}active{% endif %} {% if child_link.links != blank %} menu-item-has-children{% endif %}">
            <a
              href="{{ child_link.url }}"
              class="dropdown-item{% if child_link.links != blank %} dropdown-toggle{% endif %}{% if child_link.current %} active {% endif %}"
              {% if child_link.current %}
                aria-current="page"
              {% endif %}
              role="button"
              {% if child_link.links != blank %}
                data-bs-toggle="dropdown"
                aria-expanded="false"
               {% endif %}
            >
              {{ child_link.title }}
            </a>
            {%- if child_link.links != blank -%}
              <ul class="dropdown-menu sub-menu">
                {%- for grandchild_link in child_link.links -%}
                  <li class="dropdown dropend menu-item
                    {% if grandchild_link.current %}
                      active
                    {% endif %}"
                  >
                    <a
                      class="dropdown-item menu-item {% if grandchild_link.current %}active{% endif %}"
                      href="{{ grandchild_link.url }}"
                      {% if grandchild_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ grandchild_link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {% endif %}
  {%- endif -%}
</li>
