<div class="enquiry-modal">
  <div class="enquiry-content">
    <button class="btn-close close-button button close-icon"> {% render 'cancel.svg' %}</button>
    <div class="enquiry-content-inner">
      {% form 'contact' %}
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">
        <div class="row m-0">
          {% if form.posted_successfully? %}
          <p class="note form-success">
            {{ 'templates.contact.form.post_success' | t }}
          </p>
        {% endif %}
        {{ form.errors | default_errors }}
          <h5 class="enquiry-title">{{ 'enquiry.form.sub_heading' | t }}</h5>
          <div class="col-sm-6 field field--with-error mb-3">
            <input
              type="text"
              id="ContactFormName"
              class="form-control"
              name="contact[Name]"
              placeholder="Name *"
              required
            >
          </div>

          <div class="col-sm-6 field mb-3">
            <input
              type="number"
              class="form-control"
              id="ContactFormPhone"
              name="contact[Phone]"
              placeholder="Phone"
            >
          </div>

          <div class="field field--with-error mb-3">
            <input
              autocomplete="email"
              type="email"
              class="form-control"
              id="ContactForm-email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              required="required"
              placeholder="{{ 'enquiry.form.email' | t }} *"
              required
            >
          </div>
  
          <div class="mb-3">
              <textarea
                rows="5"
                type="textarea"
                class="form-control"
                id="ContactFormMsg"
                name="contact[Msg]"
                placeholder="Subject"
              >
              </textarea>
          </div>

          <div class="enquiry-choose form-check mb-3">
            <input
              type="radio"
              class="form-check-input"
              id="ContactViaEmail"
              name="contact[By]"
              value="Email"
            >
            <label for="ContactViaEmail">{{ 'enquiry.form.by_email' | t }}</label>
            <input
              type="radio"
              class="form-check-input"
              id="contactFormViaPhone"
              name="contact[By]"
              value="Phone"
            >
            <label for="contactFormViaPhone">{{ 'enquiry.form.by_phone' | t }}</label>
            <input
              type="radio"
              class="form-check-input"
              id="contactFormViaBoth"
              name="contact[By]"
              value="Both"
            >
            <label for="contactFormViaBoth">{{ 'enquiry.form.by_both' | t }}</label>
            <input
              type="hidden"
              id="Product_name"
              class="input-full"
              name="contact[Product_name]"
              placeholder="{{ 'contact.form.product' | t }}"
              value="{{ product.title }} - {{ product.vendor }}"
            >
          </div>
          <div>
            <button type="submit" class="button btn btn-primary">{{ 'templates.contact.form.send' | t }}</button>
          </div>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
