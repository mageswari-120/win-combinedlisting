
<!-- Button to open the offcanvas menu for mobile -->
<button
  class="navbar-toggler mx-2 me-lg-0 d-lg-none p-2 nav-link"
  type="button"
  data-bs-toggle="offcanvas"
  data-bs-target="#mobileNavigation"
  aria-controls="mobileNavigation"
  aria-label="mobileNavigation"
>
  <span class="navbar-toggler-icon"> {% render 'menu-icon' %}</span>
</button>

<!-- Offcanvas menu for mobile -->
<div
  class="offcanvas mobile_drawer offcanvas-end d-lg-none d-flex justify-content-between color-{{ settings.offcanvas_color_scheme }} gradient"
  tabindex="-1"
  id="mobileNavigation"
  aria-labelledby="mobileNavigation"
>
  <div class="offcanvas-top">
    <div class="offcanvas-header border-bottom justify-content-between">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {% assign width = settings.logo_width | divided_by: 1.25 | round %}
        {% capture sizes %}(max-width: {{ settings.logo_width | times: 1.25 }}px) 50vw , {{ settings.logo_width | divided_by: 1.25 | round}}px{% endcapture %}
        {% capture widths %}{{ settings.logo_width | divided_by: 0.75 | round }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
         <a href="{{ routes.root_url }}" class="header-logo">{{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'img-fluid',
            widths: widths,
            height: logo_height,
            width: width,
            sizes: sizes,
            alt: logo_alt,
            preload: true
        }}</a>
      {%- else -%}
        <h2 class="wdt-logo-title">
            <a href="{{ routes.root_url }}" class="header-title">{{ shop.name }}</a></h2>
      {%- endif -%}
      <button type="button" class="btn-close m-0" data-bs-dismiss="offcanvas" aria-label="Close">{% render 'cancel.svg' %} </button>
    </div>
    <div class="offcanvas-body mobile-localization flex-grow-0">
      <div id="Menu-container" class="menu-drawer-container">
        <div id="menu-drawer">
          <div class="menu-panel__inner-container">
            <nav class="menu-panel__navigation-container">
              <ul class="navbar-nav navbar-nav-scroll me-auto mobile_navigation" role="list" id="menuGroup">
                {%- for link in section.settings.menu.links -%}
                  <li class="nav-item text-wrap">
                    {%- if link.links != blank -%}
                      <a
                        class="nav-link heading_link  dropdown-toggle d-flex justify-content-between h5"
                        href="#collapse-{{ link.handle }}"
                        data-bs-toggle="collapse"
                        role="button"
                        aria-expanded="false"
                        aria-controls="collapse-{{ link.handle }}"
                      >
                        {{ link.title | escape }}
                        <span class="dt-sc-caret d-flex align-items-center"> {% render 'arrow-svg' %}</span>
                      </a>
                      <div class="collapse" id="collapse-{{ link.handle }}" data-bs-parent="#menuGroup">
                        <ul class="list-unstyled ps-3 nav_child">
                          {%- for childlink in link.links -%}
                            <li class="nav-item">
                              {%- if childlink.links == blank -%}
                                <a
                                  id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                  href="{{ childlink.url }}"
                                  class="nav-link grand-child-link {% if childlink.current %} menu-panel__menu-item--active text-decoration-underline{% endif %}"
                                  {% if childlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ childlink.title | escape }}
                                </a>
                              {%- else -%}
                                <a
                                  class="nav-link heading_link dropdown-toggle text-deccoration-none  d-flex justify-content-between"
                                  href="#collapse-{{ link.handle }}-{{ childlink.handle }}"
                                  data-bs-toggle="collapse"
                                  role="button"
                                  aria-expanded="false"
                                  aria-controls="collapse-{{ link.handle }}-{{ childlink.handle }}"
                                >
                                  {{ childlink.title | escape }}
                                  <span class="dt-sc-caret d-flex align-items-center"> {% render 'arrow-svg' %}</span>
                                </a>
                                <div
                                  class="collapse"
                                  id="collapse-{{ link.handle }}-{{ childlink.handle }}"
                                  data-bs-parent="#collapse-{{ link.handle }}"
                                >
                                  <ul class="list-unstyled ps-3 py-0">
                                    {%- for grandchildlink in childlink.links -%}
                                      <li class="nav-item">
                                        <a
                                          id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                          href="{{ grandchildlink.url }}"
                                          class="nav-link grand-child-link py-2{% if grandchildlink.current %} menu-panel__menu-item--active text-decoration-underline{% endif %}"
                                          {% if grandchildlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          {{ grandchildlink.title | escape }}
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- else -%}
                      <a
                        id="HeaderDrawer-{{ link.handle }}"
                        href="{{ link.url }}"
                        class="nav-link heading_link h5{% if link.current %} menu-panel__menu-item--active text-decoration-underline{% endif %}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="offcanvas-footer border-top mt-3 d-lg-none">
    <div class="nav nav-justified justify-content-between align-items-center">
      {%- if shop.customer_accounts_enabled and section.settings.account -%}
        <div class="wdt-header-account-item d-flex justify-content-center align-items-center">
          <a
            class=" header__icons header-account border-0"
            href="{%- if customer -%}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            aria-label="{%- if customer -%}{{ 'customer.login_account' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}"
          >
            {%- if section.settings.enable_customer_avatar -%}
              <account-icon>
                {%- if customer or customer.has_avatar? -%}
                  {{ customer | avatar }} {{ 'customer.login_account' | t }}
                {%- else -%}
                  {% render 'icon-user' %}
                 {%- endif -%}
              </account-icon>
            {%- else -%}
              {% render 'icon-user' %}
            {%- endif -%}
          </a>
        </div>
      {% endif %}


      {%- if localization.available_countries and section.settings.enable_country_selector or localization.available_languages and section.settings.enable_language_selector  -%}
        <div class="menu-drawer__utility-links mobile-localization d-flex justify-content-center pt-1">
            <div class="menu-drawer__localization header-localization d-flex flex-wrap justify-content-between my-3">
              <div class="navbar-nav flex-row  gap-2">
                {% if section.settings.enable_country_selector %}
                  {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                    <localization-form>
                      {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                        <div>
                          <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                            {{ 'localization.country_label' | t }}
                          </h2>
                          {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                        </div>
                      {%- endform -%}
                    </localization-form>
                  {% endif %}
                {% endif %}
                {% if section.settings.enable_language_selector %}
                  {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                    <localization-form>
                      {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                        <div>
                          <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                            {{ 'localization.language_label' | t }}
                          </h2>
                          {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                        </div>
                      {%- endform -%}
                    </localization-form>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
