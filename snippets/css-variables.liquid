{% style %}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}

    {% for scheme in settings.color_schemes -%}
    {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
    {% if forloop.index == 1 -%}
    :root,
    {%- endif %}
    .color-{{ scheme.id }} {
    --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
    --gradient-background: {{ scheme.settings.background }};

    {% liquid
    assign background_color = scheme.settings.background
    assign background_color_brightness = background_color | color_brightness
    if background_color_brightness <= 26
    assign background_color_contrast = background_color | color_lighten: 50
    elsif background_color_brightness <= 65
    assign background_color_contrast = background_color | color_lighten: 5
    else
    assign background_color_contrast = background_color | color_darken: 25
    endif
    %}

    --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
    --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
    --color-heading: {{ scheme.settings.heading_color.red }},{{ scheme.settings.heading_color.green }},{{ scheme.settings.heading_color.blue }};

    --color-primary-button-bg: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
    --color-primary-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
    --color-primary-button-border:{{ scheme.settings.button_border.red }},{{ scheme.settings.button_border.green }},{{ scheme.settings.button_border.blue }};
    --color-primary-button-hover-bg: {{scheme.settings.hover_button.rgb | replace:" ",","}};
    --color-primary-button-hover-text:  {{scheme.settings.hover_button_label.rgb | replace:" ",","}};
    --color-primary-button-hover-border: {{scheme.settings.hover_button_border.rgb | replace:" ",","}};

    --color-secondary-button-bg: {{ scheme.settings.secondary_button.red }},{{ scheme.settings.secondary_button.green }},{{ scheme.settings.secondary_button.blue }};
    --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
    --color-secondary-button-border:{{ scheme.settings.secondary_border.red }},{{ scheme.settings.secondary_border.green }},{{ scheme.settings.secondary_border.blue }};
    --color-secondary-button-hover-bg: {{scheme.settings.hover_secondary_button.rgb | replace:" ",","}};
    --color-secondary-button-hover-text:  {{scheme.settings.hover_secondary_button_label.rgb | replace:" ",","}};
    --color-secondary-button-hover-border: {{scheme.settings.hover_secondary_border.rgb | replace:" ",","}};

    --color-link: {{ scheme.settings.link_color.red }},{{ scheme.settings.link_color.green }},{{ scheme.settings.link_color.blue }};
    --color-link-hover: {{ scheme.settings.link_hover.red }},{{ scheme.settings.link_hover.green }},{{ scheme.settings.link_hover.blue }};

    --color-border: {{ scheme.settings.color_border.red }},{{ scheme.settings.color_border.green }},{{ scheme.settings.color_border.blue }};
    --color-input-bg: {{ scheme.settings.color_input.red }},{{ scheme.settings.color_input.green }},{{ scheme.settings.color_input.blue }};
    --color-input-text: {{ scheme.settings.color_input_text.red }},{{ scheme.settings.color_input_text.green }},{{ scheme.settings.color_input_text.blue }};

    --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
    --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
    --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};

    --sale-badge-bg:{{ settings.sale_badge_background.red  }},{{ settings.sale_badge_background.green }},{{ settings.sale_badge_background.blue }};
    --sale-badge-text:{{ settings.sale_badge_text.red  }},{{ settings.sale_badge_text.green }},{{ settings.sale_badge_text.blue }};
    --sold-out-badge-bg:{{ settings.sold_out_background.red  }},{{ settings.sold_out_background.green }},{{ settings.sold_out_background.blue }};
    --sold-out-badge-text:{{ settings.sold_out_text.red  }},{{ settings.sold_out_text.green }},{{ settings.sold_out_text.blue }};
    --new-badge-bg:{{ settings.new_badge_background.red  }},{{ settings.new_badge_background.green }},{{ settings.new_badge_background.blue }};
    --new-badge-text:{{ settings.new_badge_text.red  }},{{ settings.new_badge_text.green }},{{ settings.new_badge_text.blue }};

    --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
    --offcanvas-border-color:rgba( var(--color-border),{{ settings.offcanvas_border_opacity | divided_by: 100.0 }});
    {% if settings.offcanvas_border != 'none' %}
    --offcanvas-border-width: {{ settings.offcanvas_border_width }}px;
    --offcanvas-border-style: {{ settings.offcanvas_border }};
    --offcanvas-bg: {{ settings.offcanvas_color_scheme.settings.background }};
    {% endif %}
    --offcanvas-border-radius: {{ settings.offcanvas_border_radius }}px;
   
    --bs-link-color-rgb:var(--color-link);
    --bs-link-color:var(--color-link);
    --bs-link-hover-color-rgb: var(--color-link-hover);
    --bs-link-hover-color: var(--color-link-hover);
    --bs-heading-color: rgb(var(--color-heading));
    --bs-border-color: var(--color-border);
    --bs-body-bg:var(--gradient-background);
    --bs-body-bg-rgb:var(--color-background);
    --bs-box-shadow: var(--bs-horizontal-width) var(--bs-vertical-width) 0px 0px  rgb(var(--color-border));
    }

    {% endfor %}

    {{ scheme_classes | prepend: 'body' }} {
    color: rgba(var(--color-foreground), 1);
    background-color: rgb(var(--color-background));
    }

    :root {

      {%- if settings.custom_font_family_2 != blank %}
      --font-body-family: {{ settings.custom_font_family_2 }};
      {% else %}
      --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      {% endif -%}
      --font-body-style: {{ settings.type_body_font.style }};
      --font-body-weight: {{ settings.type_body_font.weight }};
      --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};
      {%- if settings.custom_font_family_1 != blank %}
      --font-heading-family: {{ settings.custom_font_family_1 }};
      {% else %}
      --font-heading-family: {{ settings.type_header_font.family }};
      {%  endif -%}
    --font-heading-style: {{ settings.type_header_font.style }};
    --font-heading-weight: {{ settings.type_header_font.weight }};
    --font-heading-transform: {{ settings.heading_transform }};
    --font-heading-color:var(--color-foreground);
     --font-heading-scale:{{settings.heading_scale | divided_by: 100.0 }};

    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --page-width: {{ settings.page_width | divided_by: 1 }}rem;
    --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;

    --bs-cube-transitions: 375ms cubic-bezier(0.7, 0, 0.3, 1);
    --bs-drop-shadow: drop-shadow(3px 3px 0px rgb(var(--color-border)));
    --bs-transition:all 0.3s linear;
    --bs-transition-2:all 0.2s linear;
    --bs-transition-1:all 0.1s linear;
    /* --bs-font-h0-size:clamp(2.8125rem, 2.25rem + 2.8125vw, 5.625rem); */  /*45 to 90*/
    --bs-font-h1-size:calc(clamp(2.25rem, 2.2rem + 0.25vw, 2.5rem) * var(--font-heading-scale)); /*36 to 40*/
    --bs-font-h2-size:calc(clamp(1.875rem, 1.8rem + 0.375vw, 2.25rem) * var(--font-heading-scale));  /*30 to 36*/
    --bs-font-h3-size:calc(clamp(1.75rem, 1.725rem + 0.125vw, 1.875rem) * var(--font-heading-scale));  /*28 to 30*/
    --bs-font-h4-size:calc(clamp(1.5rem, 1.5rem + 0vw, 1.5rem) * var(--font-heading-scale)); /* 24 */
    --bs-font-h5-size:calc(clamp(1.125rem, 1.125rem + 0vw, 1.125rem) * var(--font-heading-scale));  /* 18 */
    --bs-font-h6-size:calc(clamp(1rem, 1rem + 0vw, 1rem) * var(--font-heading-scale));  /* 16 */
    --bs-font-xs:12px; /*custom font size*/
    --bs-font-sm:14px;
    --bs-font-md:16px;
    --bs-shadow:5px 0px 30px 0px rgba(0, 0, 0, 0.08);
     {% if settings.card_style == 'classic' %}
      --bs-space-x: 20px;
      {% else %}
      --bs-space-x: 20px;
    {% endif %}

   /*--overall-border-radius :{{settings.corner_radius}};*/ /*border-radius using boostrap*/


    /*text-shadow*/
    --bs-stroke-width:{{settings.shadow_thickness}}px;
    --bs-text-stroke-width:{{settings.text_stroke}}px;
    --bs-text-shadow-opacity:{{settings.shadow_opacity}}%;
    /*button-shadow*/
    --bs-button-stroke-width:{{settings.button_shadow_thickness}}px;
    --bs-button-text-stroke-width:{{settings.button_text_stroke}}px;
    --bs-button-text-stroke-opacity:{{settings.button_shadow_opacity}}%;
    --bs-horizontal-width:{{settings.buttons_shadow_horizontal_offset}}px;
    --bs-vertical-width:{{settings.buttons_shadow_vertical_offset}}px;
    
      {% assign primary_font ='--font-body-family' %}
      {% case settings.primary_font %}
      {% when 'body' %}{% assign primary_font ='--font-body-family' %}
      {% when 'heading' %}{% assign primary_font ='--font-heading-family' %}
      {% endcase %}
      
      {% assign secondary_font ='--font-body-family' %}
      {% case settings.secondary_font %}
      {% when 'body' %}{% assign secondary_font ='--font-body-family' %}
      {% when 'heading' %}{% assign secondary_font ='--font-heading-family' %}
      {% endcase %}
      
      {% assign link_font ='--font-body-family' %}
      {% case settings.link_font %}
      {% when 'body' %}{% assign link_font ='--font-body-family' %}
      {% when 'heading' %}{% assign link_font ='--font-heading-family' %}
      {% endcase %}
    --bs-border-1:1px; /*custom border*/
    --bs-border-2:2px;
    --bs-border-3:3px;
    --bs-border-4:4px;
    --bs-border-5:5px;
    --bs-border-radius-1:1px; /*custom border-raius*/
    --bs-border-radius-2:2px;
    --bs-border-radius-3:3px;
    --bs-border-radius-4:4px;
    --bs-border-radius-5:5px;
    --bs-border-style:solid;
    --border-width:var(--bs-border-1); /* if using stright value in offcanvas filter border bottom*/
    --bs-border-width:var(--bs-border-1); /* Static value*/ 
    --overall-border-radius:0;  

     /*font*/ 
    --bs-primary-font:var({{primary_font}});
    --bs-secondary-font:var({{secondary_font}});
    --bs-link-font:var({{link_font}}); 
    /*test-case*/   
     --bs-primary-testcase: {{settings.primary_testcase}};
     --bs-secondary-testcase: {{settings.secondary_testcase}}; 
     --bs-link-testcase:{{settings.link_testcase}};
    /*thickness*/
     --bs-primary-thickness: {{settings.primary_thickness}}px;
     --bs-secondary-thickness: {{settings.secondary_thickness}}px;
     --bs-primary-opacity:{{settings.primary_opacity | divided_by: 100.0}};
     --bs-secondary-opacity:{{settings.secondary_opacity | divided_by: 100.0 }};
     /*radius*/
     --bs-primary-radius :{{settings.primary_radius}}px;
     --bs-secondary-radius :{{settings.secondary_radius}}px;
     /*shadow*/
    --bs-primary_horizontal_offset: {{settings.primary_horizontal_offset }}px;
    --bs-primary_vertical_offset: {{settings.primary_vertical_offset}}px;
    --bs-secondary_horizontal_offset: {{settings.secondary_horizontal_offset }}px;
    --bs-secondary_vertical_offset: {{settings.secondary_vertical_offset}}px;
    /*input*/
    --bs-input-border-radius :{{settings.input_corner_radius}}px;
    --bs-input-border-width: {{ settings.input_border_thickness }}px;
     /*opacity*/
    --background-opacity: {{section.settings.background_opacity}};
    --defalut_border:var(--bs-border-1);
    --shopify-accelerated-checkout-inline-alignment: center;
    --shopify-accelerated-checkout-skeleton-animation-duration: 0.3s;
    --shopify-accelerated-checkout-button-border-radius: {{ button_radius }};
    --shopify-accelerated-checkout-button-block-size:60px;
     
      
    }

    *,
    *::before,
    *::after {
    box-sizing: inherit;
    }
    html {
    box-sizing: border-box;
    font-size: calc(1 * 100%);
    height: 100%;
    }
    body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    grid-template-columns: 100%;
    min-height: 100%;
    margin: 0;
    font-size: calc(var(--font-body-scale) * 100%);
    /* letter-spacing: 0.06rem; */
    line-height: calc(1 + 0.8 / var(--font-body-scale));
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    overflow-x:hidden;
    }

    @media screen and (min-width: 768px) {
    body {
    font-size: 1.125rem;
    }
    }
