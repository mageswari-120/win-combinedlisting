}



/* popup style */

.popup_modal .modal-header {
  border-bottom: 1px solid #f0f0f0;
  padding: 20px 30px;
}
.popup_modal .modal-body {
    padding: 30px;
}
.popup_modal .modal-content {
    border-radius: 15px;
    border: none;
}

/* form style start */
.popup_modal .form-control {
  padding: 14px 20px;
  font-size: var(--bs-font-sm);
  margin-bottom: 10px;
}
.popup_modal textarea {
  border-radius: 20px;
  resize: none;
}

@media (max-width: 575.98px){
  .popup_modal .modal-header, .popup_modal .modal-body {
    padding: 15px;
}
}
/* form style end */




/* popup modal share start */
@media (min-width: 768px){
.popup_modal_share .modal-dialog{ width: min(370px, 100%); }
}
.popup_modal_share .copy-url-btn {
    min-width: 50px;
    min-height: 50px;
    padding: 0;
}
.popup_modal_share :is(.modal-link button){ transition:all .3s linear; width:40px; height:40px;}


/* popup modal share end */




