  background: rgb(var(--color-primary-button-bg));
  border-radius: 50%;
  border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-border),.2);
  cursor:pointer;
  }
  
 .wishlist_button, .compare_button, 
  button.quick-view-btn, 
 .wishlist_button a, .compare_button a{
    transition: all .3s linear;
  }
 .wishlist_button a:hover, .compare_button a:hover{
