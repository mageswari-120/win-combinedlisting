     border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-hover-border));
  }
 .wishlist_button a:hover, .compare_button a:hover{
     color: rgb(var(--color-primary-button-hover-text));
  }
  button.quick-view-btn:hover{
     background: rgb(var(--color-primary-button-hover-bg));
     color: rgb(var(--color-primary-button-hover-text));
     border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-hover-border));
