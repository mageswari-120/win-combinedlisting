 .compare_button a {
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(var(--color-primary-button-bg));
  border-radius: 50%;
  border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-border));
  border-color: transparent;
  }
