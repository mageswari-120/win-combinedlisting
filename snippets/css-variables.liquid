/*Card icons*/


.cart-item__error:has(small.cart-item__error-text:empty) svg {
  display: none;
}
.card__inner_wrapper .product_card_icons {
    cursor:pointer; 
    position:absolute; 
    width:auto; 
    height:auto; 
    right: 0; 
    left: auto;   
    display: flex;
    flex-direction: column;
    gap: 10px; 
    top:20px;
    right:20px;
    transform: translate(20px);
    opacity:0;
    transition: all .2s linear;
}

.card__inner_wrapper .quick_view .quick-add {
    position: absolute;
    z-index: 1;
    bottom: 15px;
    right: 0;
    left: 0;
    padding-inline: 15px;
    opacity: 0;
    transition: all .2s linear;
}

.resource-card:hover .card__inner_wrapper :is(.product_card_icons,.quick_view .quick-add){
  transform: translate(0px);
  opacity:1;
  transition: all .2s linear;
}
.resource-card .card-image :is(.deal_count){ transition: all .2s linear; }
.resource-card:hover .card-image :is(.deal_count){
  opacity: 0;
  transition: all .2s linear;
}
facet-filters-form:has(.grid-layout .one_column.active) ~ .collection .product-grid .resource-card .card-image :is(.deal_count){ opacity: 1; }

.resource-card .quick_view button {
    padding-inline: 0.63rem;
    padding-block: .88rem;
    border-color: transparent;
}

 .card-image img {
    transition: all .2s linear;
}
 .card-image img:hover {
    transform: scale(1.1);
 }
cart-remove-button,
cart-remove-button > button {
  width: var(--dt-btn-size);
  height: var(--dt-btn-size);
  justify-content: center;
}
.card.classic img,
.card.classic .placeholder-svg {
  width: 100%; /*video full needed the width*/
