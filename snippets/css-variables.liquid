  }
  .product_card_icons .compare_button,
   .resource-card .quick_view{ display: none !important; }
  .product_card_icons .wishlist_button,
  .product_card_icons .add-wishlist,
  .product_card_icons .compare_button,
  .product_card_icons button.quick-view-btn
  {
    width:35px;
    height:35px;
  }
  .product_card_icons .wishlist_button .add-wishlist:before,
  .product_card_icons .compare_button .add-compare:before,
  .quick-view-btn svg
  {
    width:16px;
    height:16px;
  }
