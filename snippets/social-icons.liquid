<ul class="list-unstyled list-social  d-flex  flex-wrap{% if class %} {{ class}}{% endif %} {% if desktop_alignment == 'left' %} justify-content-sm-start align-items-sm-start 
  {% elsif desktop_alignment == 'center' %} justify-content-sm-center align-items-sm-center {% else %} justify-content-sm-end align-items-sm-end {% endif %}
  {% if mobile_alignment == 'left' %} justify-content-start  {% elsif mobile_alignment == 'center' %} justify-content-center {% else %} justify-content-end {% endif %}
  " role="list">
  {%- if settings.social_instagram_link != blank -%}
    <li class="list-social__item  {{ link_class}} {{ icon_style }}">
      <a href="{{ settings.social_instagram_link }}" class="link list-social__link text-decoration-none text-reset">
        {%- render 'icon-instagram' -%}
        <span class="social-icon-items visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
      </a>
    </li>
  {%- endif -%}
    {%- if settings.social_facebook_link != blank -%}
