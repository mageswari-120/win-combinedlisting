{%- liquid
if lazy_load
assign lazy = 'lazy'
else
if index == 1
assign lazy = 'eager'
else
assign lazy = 'lazy'
endif
endif
if lazy_load
assign fetchpriority = 'auto'
else
if index == 1
assign fetchpriority = 'high'
else
assign fetchpriority = 'auto'
endif
endif
   %}
{% assign page_width_in_px = settings.page_width | times: 16 %}
{%- capture sizes -%}  
(min-width: {{ page_width_in_px }}px) {{ page_width_in_px | minus: 100 | divided_by: columns }}px,
(min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
calc(100vw - 3rem)
{%- endcapture -%}
{%-  capture widths -%}
  320, 540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946
{%- endcapture -%}
{% if collectionlist_style == 'modern' %}
  <div class="collection-cards card color-{{ collection_background }} gradient  border overflow-hidden">
      {%- if card_collection.featured_image -%}
          <div class="card__inner position-relative border-bottom ratio  
                {% case media_aspect_ratio -%}
                      {%- when 'square' -%}
                        ratio-1x1
                      {%- when 'portrait' -%}
                        ratio-3x4
                      {%- when 'adapt' -%}
                        ratio-auto
                      {%- else -%}
                        ratio-1x1
                    {%- endcase -%} "  
        {% if media_aspect_ratio == 'adapt' %}  style=" --aspect-ratio: {%- if card_collection.featured_image -%}{{ 1 | divided_by: card_collection.featured_image.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};"{% endif %}>
             <a  {% if card_collection == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ card_collection.url }}"
                {% endif %} class="card--image p-4" aria-label="{{ card_collection.title }}">               
             {{ card_collection.featured_image 
              | image_url: width: 960
              | image_tag: sizes: sizes, 
                height: card_collection.featured_image.height, 
                width: card_collection.featured_image.width, 
                widths: widths,
                class: 'border',                
                loading: lazy, 
                fetchpriority: fetchpriority
               }}
             </a>            
          </div>
        {% else %}
         <div class="card__inner position-relative border-bottom ratio  
                {% case media_aspect_ratio -%}
                      {%- when 'square' -%}
                        ratio-1x1
                      {%- when 'portrait' -%}
                        ratio-3x4
                      {%- when 'adapt' -%}
                        ratio-auto
                      {%- else -%}
                        ratio-1x1
                    {%- endcase -%} "  
        {% if media_aspect_ratio == 'adapt' %}  style=" --aspect-ratio: {%- if card_collection.featured_image -%}{{ 1 | divided_by: card_collection.featured_image.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};"{% endif %}>
         <a role="link" aria-disabled="true" class="card--image p-3" aria-label="{{ card_collection.title }}"> 
           {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg border' }}
         </a>
         </div>  
      {%- endif -%} 
    {%- if card_collection != blank -%}
        <div class="card-body position-relative p-3 p-sm-4 text-{{ collection_card_column_alignment }} {%- if description and card_collection.description != blank -%}card-body-text{%- endif -%}">
          {% if collection_count %}
          {%- if card_collection.all_products_count.size > 0  and  card_collection.featured_image -%}
          <div class="collection_product_count"> <span> {{ 'sections.collection_list.count' | t: count: card_collection.all_products_count }}</span> </div>
          {% else %}
           <div class="collection_product_count"> <span> {{ 'sections.collection_list.count' | t: count: 0 }}</span> </div>
          {%-  endif -%}
          {% endif %}
            <h3 class="card-title mt-1 m-0 h4">
              <a
                {% if card_collection == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ card_collection.url }}" 
                {% endif %}
                class="card-link"
              >
                {%- if card_collection.title != blank -%}
               {{- card_collection.title | escape -}}
                {%- else -%}
                {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
              </a>
            </h3>
            {%- if description -%}
              <p class="card-text pt-2">
                {{- card_collection.description | strip_html | truncatewords: 12  -}}
              </p>
            {%- endif -%}  
        </div>   
    {%- endif -%}
   {%- if card_collection == blank -%}  
        <div class="card-body p-3 p-sm-4">
          <div class="text-{{ collection_card_column_alignment }}">
            <h4 class="card-title mt-1 m-0"> {{ 'onboarding.collection_title' | t }} </h4>             
          </div>
          <div>           
          </div>            
        </div>
  {%- endif -%}
  </div>
 {% else %} 
