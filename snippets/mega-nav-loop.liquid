{% assign child_count = link.links.size %}
<ul class="list-unstyled row row-cols-2 {% if child_count > 3 -%} row-cols-xl-4 {% else -%} row-cols-xl-3 {% endif %} g-4">
  {%- for child_link in link.links -%}
    <li class="col dropdown px-3 px-xl-4  ">
      <a
        class="text-wrap px-0 px-xxl-0 h5 {% if child_link.current %} active {% endif %} text-decoration-none"
        href="{{ child_link.url }}"
        {% if child_link.current %}
          aria-current="page"
        {% endif %}
      >        
        {{ child_link.title }}
      </a>
      {%- if child_link.links != blank -%}
        <ul class="list-unstyled sub-menu mt-4">
          {%- for grandchild_link in child_link.links -%}
            <li class="menu-item{% unless forloop.last %} mb-2{% endunless %}{% if grandchild_link.current %} active{% endif %}">
              <a
                class="px-0 px-xxl-0 text-wrap{% if grandchild_link.current %} active{% endif %}  text-decoration-none"
                href="{{ grandchild_link.url }}"
                {% if grandchild_link.current %}
                  aria-current="page"
                {% endif %}
              >
                <span>{{ grandchild_link.title }}</span>            
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>

