{% comment %}
  Promo tiles section

  - Renders a grid of promotional tiles (image + text + link)
  - Each tile is a block that merchants can configure in the theme editor
  - Tiles can link to products, collections, pages, blogs, or custom URLs

  This is intentionally not tied to product data so it can be used for:
  - Campaigns (Black Friday, New arrivals, etc.)
  - Category navigation (Men, Women, Kids)
  - Content promotion (Story, About, Sustainability)
{% endcomment %} 

<section class="promo-tiles" {{ section.shopify_attributes }}>
  <div class="promo-tiles__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="promo-tiles__header">
        {% if section.settings.heading != blank %}
          <h2 class="promo-tiles__title">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="promo-tiles__subtitle">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
  class="swiper promo-tiles__viewport{% if section.settings.enable_slider %} promo-tiles__viewport--slider{% endif %}"
  style="--promo-tiles-gap: {{ section.settings.tile_gap }}px;"
  data-promo-tiles
  data-enable-slider="{{ section.settings.enable_slider }}"
  data-columns="{{ section.settings.columns_desktop }}"
>
        <div
          class="swiper-wrapper promo-tiles__grid{% unless section.settings.enable_slider %} promo-tiles__grid--columns-{{ section.settings.columns_desktop }}{% endunless %}"
          data-promo-tiles-track
        >
          {% for block in section.blocks %}
            <div class="swiper-slide">
            {% assign has_link = false %}
            {% if block.settings.link_url != blank %}
              {% assign has_link = true %}
            {% endif %}

            {% if has_link %}
              <a class="promo-tile" href="{{ block.settings.link_url }}" {{ block.shopify_attributes }}>
            {% else %}
              <div class="promo-tile" {{ block.shopify_attributes }}>
            {% endif %}

              <div class="promo-tile__media">
                {% if block.settings.image %}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
                {% if block.settings.badge_text != blank %}
                  <span class="promo-tile__badge">{{ block.settings.badge_text | escape }}</span>
                {% endif %}
              </div>

              <div class="promo-tile__content">
                {% if block.settings.heading != blank %}
                  <h3 class="promo-tile__heading">{{ block.settings.heading | escape }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="promo-tile__text">{{ block.settings.text | escape }}</p>
                {% endif %}
                {% if has_link and block.settings.show_link_label and block.settings.link_label != blank %}
                  <span class="promo-tile__link-label">{{ block.settings.link_label | escape }}</span>
                {% endif %}
              </div>

            {% if has_link %}
              </a>
            {% else %}
              </div>
            {% endif %}
        </div>
          {% endfor %}
        </div>

        {% if section.settings.enable_slider and section.blocks.size > 1 %}
          <div class="promo-tiles__controls">
            <button type="button" class="promo-tiles__control promo-tiles__control--prev" data-promo-tiles-prev aria-label="Previous promotions"></button>
            <button type="button" class="promo-tiles__control promo-tiles__control--next" data-promo-tiles-next aria-label="Next promotions"></button>
          </div>
          <div class="promo-tiles__pagination" data-promo-tiles-pagination></div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

 {% stylesheet %}
   .swiper {
      width: 100%;
      height: 100%;
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      background: #444;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
{% endstylesheet %}
{% schema %}
{
  "name": "promo tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Promotions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Highlight key collections, campaigns, or content with promotional tiles." },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "tile_gap", "label": "Tile gap (px)", "min": 8, "max": 40, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "enable_slider", "label": "Enable slider", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "New" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Promo tile heading" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the promotion, collection, or content you want to highlight." },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "inline_richtext", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "checkbox", "id": "show_link_label", "label": "Show link label", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}