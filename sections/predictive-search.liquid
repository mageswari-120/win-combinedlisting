{% if predictive_search.performed %}
  {% assign has_result = predictive_search.resources.queries.size
    | plus: predictive_search.resources.collections.size
    | plus: predictive_search.resources.pages.size
    | plus: predictive_search.resources.articles.size
  %}

  <div
    role="listbox"
    {% if predictive_search.resources.size == 0 %}
      inert
    {% endif %}
  >
    <div id="predictive-search-results-groups-wrapper">
      {%- if settings.search_type == 'form' -%}
        <div class="form_model row flex-column-reverse flex-md-row w-100">
      {% endif %}
      {%- if settings.show_collections or settings.show_pages or settings.show_articles -%}
      {% if has_result > 0  %}
        <aside class="{%- if settings.search_type == 'icon' -%} col-12 col-md-4 col-xl-3 row row-cols-1 row-cols-sm-2 row-cols-xl-1 {% else %} col-12 col-md-4 col-xl-3 pages_wrapper {% endif %}" >
      {% endif %}

      {%- if settings.show_collections  -%}
        {% if predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 %}
          <div class="product-widget-item mb-3">
            <h3 class="title mb-4 {% if settings.search_type == 'form' %} h5 {% endif %}">
              {{ 'templates.search.collections' | t }}
            </h3>
            <ul class="list-group list-unstyled text-wrap">
              {% for query in predictive_search.resources.queries %}
                <li>
                  <a href="{{ query.url }}" class="text-decoration-none text-reset">
                    <div>
                      <p aria-label="{{ query.text }}" class="mb-2">{{ query.styled_text }}</p>
                    </div>
                  </a>
                </li>
              {% endfor %}
              {% for collection in predictive_search.resources.collections %}
                <li>
                  <a href="{{ collection.url }}" class="text-decoration-none text-reset">
                    <div>
                      <p class="mb-2">{{ collection.title | escape }}</p>
                    </div>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {%- endif -%}

      {%- if settings.show_pages -%}
        {% if predictive_search.resources.pages.size > 0 %}
          <div class="product-widget-item mb-3">
            <h5 class="title mb-4{% if settings.search_type == 'form' %} h5 {% endif %}">
              {{ 'templates.search.pages' | t }}
            </h5>
            <ul class="list-group px-0 text-wrap">
              {% for page in predictive_search.resources.pages %}
                <li>
                  <a href="{{ page.url }}" tabindex="0" class="text-decoration-none text-reset">
                    <div>
                      <p class="mb-2">{{ page.title | escape }}</p>
                    </div>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {%- endif -%}

      {%- if settings.show_articles -%}
        {% if predictive_search.resources.articles.size > 0 %}
          <div class="product-widget-item mb-3">
            <h5 class="title mb-4{% if settings.search_type == 'form' %} h5 {% endif %}">
              {{ 'templates.search.articles' | t }}
            </h5>
            <ul class="list-group px-0 text-wrap">
              {% for article in predictive_search.resources.articles %}
                <li>
                  <a href="{{ article.url }}" tabindex="0" class="text-decoration-none text-reset">
                    <div>
                      <p class="mb-2">{{ article.title | escape }}</p>
                    </div>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {%- endif -%}

      
      {% if has_result > 0 %}
        </aside>
      {% endif %}
       {% endif %}
      {%- if settings.show_products -%}
        {% if predictive_search.resources.products.size > 0 %}
          <div class="{%- if settings.search_type == 'icon' -%}icon-search col-12 col-md-8 col-xl-9 me-0 ms-auto {% else %}search-bar col-12 col-md-8 col-xl-9 product_wrapper mb-4  pe-lg-4 pe-xxl-5 {% endif %}">
            <div class="product-search-list">
              <h3 class="mb-4 {% if settings.search_type == 'form' %} h5 {% endif %}">
                {{ 'templates.search.products' | t }}
              </h3>
              <div class="product_container list-unstyled row row-cols-1 row-cols-md-1 row-cols-xxl-2 g-4">
                {% for product in predictive_search.resources.products %}
                  <div class="product_grid overflow-hidden">
                    <div class="card main-card d-flex flex-row  gap-3 {% if settings.inherit_color_scheme == false %} color-{{ settings.searchcard_color_scheme }} gradient p-3 {% endif %}">
                      <div
                        class="card-image border-style overflow-hidden "
                        style="
                          --border-width: {{ settings.search_border_width }}px;
                          --border-style: {{ settings.search_border }};
                          --border-color: rgba(var(--color-border), {{ settings.search_border_opacity | divided_by: 100.0 }});
                          --border-radius:{{ settings.search_border_radius }}px;
                        "
                      >
                        <a href="{{ product.url }}" class="text-decoration-none ">
                          {% if product.featured_media != blank %}
                            {{
                              product.featured_media
                              | image_url: width: 1080
                              | image_tag: class: 'w-100 h-100 img-fluid object-fit-cover rounded-0'
                            }}
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag }}
                          {% endif %}
                        </a>
                      </div>
                      <div class="card-body p-0 ">
                        <div class="card-body-information">
                          <h5 class="card-title {% if settings.search_type == 'form' %} h6 mb-2 {% endif %}">
                            <a href="{{ product.url }}" class="text-decoration-none"> {{ product.title | escape }} </a>
                          </h5>
                          {% if settings.show_price %}
                            {% render 'price',
                              product: product,
                              price_class: 'gap-0',
                              show_compare_at_price: true,
                              show_badges: false
                            %}
                          {% endif %}
                          <div class="card-description rte {% if settings.search_type == 'icon' %} d-none d-md-block {% else %} d-none {% endif %}">
                            {{ product.description | strip_html | truncate: 80 }}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      {%- endif -%}
      {%- if settings.search_type == 'form' -%}</div>{% endif %}
      {% if predictive_search.resources.products == blank
        and predictive_search.resources.pages == blank
        and predictive_search.resources.articles == blank
      %}
        {% liquid
          assign total_results = predictive_search.resources.products.size | plus: has_result
          if total_results == 0
            echo 'templates.search.no_results' | t: terms: predictive_search.terms
          endif
        %}
      {% else %}
        <button
          class="btn btn-primary predictive-search__item predictive-search__item--term"
          tabindex="-1"
          role="option"
          aria-selected="false"
        >
          {{ 'templates.search.search_for' | t: terms: predictive_search.terms }}
        </button>
      {% endif %}
    </div>
  </div>
{% endif %}
