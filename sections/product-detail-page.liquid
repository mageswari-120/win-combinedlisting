<product-template data-variantid="{{ product.selected_or_first_available_variant.id }}">
  {% style %}
  .product-thumbnails[data-direction="stacked"] ~ .product-main-gallery .swiper-slide,
.product-main-gallery .swiper-slide {
  width: 100% !important;
}
.stacked .swiper-wrapper { display: block; }
 .swiper {
      width: 100%; 
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      background: #444;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Main gallery */
product-gallery.stacked .swiper-slide {
  width: 100%;
}

product-gallery.stacked .product-thumbnails {
  display: none; 
}

    .swiper-slide {
      width: 80%;
    }

    .swiper-slide:nth-child(2n) {
      width: 60%;
    }

    .swiper-slide:nth-child(3n) {
      width: 40%;
    }
    .swiper-slide.thumbnail-slide.media-child {
        width: 20%;
    }
    /* Vertical thumb strip */
.product-thumbnails[data-thumbnail_type="vertical"] {
  height: 400px; /* match your main gallery height */
  width: 80px;
}

.product-thumbnails[data-thumbnail_type="vertical"] .swiper-wrapper {
  flex-direction: column;  
}

.product-thumbnails[data-thumbnail_type="vertical"] .swiper-slide {
  height: 80px;
  width: 100% !important;  
}

 
 
  {% endstyle %}
 
    {%- liquid
    assign popups = section.blocks | where: 'type', 'modal_text'
    render 'popup-loop', popups: popups
    assign canvas_block = section.blocks | where: 'type', 'canvas_panel'
    assign description_block = section.blocks | where: 'type', 'description'
    assign combined_blocks = canvas_block | concat: description_block 
    assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
    for block in section.blocks
      case block.type
        when 'share-modal'
          assign share_title = block.settings.share_label
          render 'share', share_link: share_url, share_title: share_title
        when 'sidebar'
          assign sidebar-position = block.settings.sidebar_position
          assign enable_sidebar = block.settings.enable_sidebar
      endcase
    endfor
  -%}

  {% comment %} nex and prev  {% endcomment %}
  {%- liquid
    assign previous_product = collection.previous_product
    assign next_product = collection.next_product

    if previous_product == null and next_product == null
      assign collectionList = product.collections[0].handle
      assign previous_product = null
      assign next_product = null
      assign last = collections[collectionList].products_count

      for p in collections[collectionList].products
        if p.handle == product.handle
          assign prev = forloop.index | minus: 2
          assign next = forloop.index

          if prev >= 0
            assign previous_product = collections[collectionList].products[prev]
          endif

          if next < last
            assign next_product = collections[collectionList].products[next]
          endif

          break
        endif
      endfor
    endif
  -%}

  {%- if previous_product or next_product -%}
    <div id="nextpre" class="container">
      <div class="product_popup position-relative">
        {%- if previous_product -%}
          <div class="next-prev-wrapper">
            <a href="{{ previous_product.url }}" class="next-prev-icon"> {% render 'left-arrow' %}</a>

            <div class="next-prev-tooltip">
              <div class="product_img">
                <img
                  src="{{ previous_product.featured_image | image_url: width: 80 }}"
                  alt="{{ previous_product.title }}"
                >
              </div>
              <div class="product_detail">
                <a href="{{ product.title }}">{{ previous_product.title }}</a>
                <p class="price">{{ previous_product.price | money }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="collection_grid">
          <a
            href="{{ product.collections.first.url }}"
            data-bs-toggle="tooltip"
            data-bs-placement="top"
            title="Back to products"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M13.8019 7.43638H10.7669C9.27167 7.43638 8.54639 6.76644 8.54639 5.40422V2.03217C8.54639 0.669945 9.27167 0 10.7669 0H13.7684C15.2636 0 15.9889 0.669945 15.9889 2.03217V5.41539C15.9889 6.07416 15.8215 6.56546 15.4756 6.90043C15.1074 7.2689 14.5718 7.43638 13.8019 7.43638ZM10.7669 1.11657C9.77379 1.11657 9.66221 1.40688 9.66221 2.03217V5.40422C9.66221 6.04067 9.76263 6.31981 10.7669 6.31981H13.7684C14.2482 6.33098 14.5495 6.25282 14.6946 6.10766C14.8173 5.98484 14.8731 5.75036 14.8731 5.41539V2.03217C14.8731 1.40688 14.7615 1.11657 13.7684 1.11657H10.7669Z" fill="#111111"></path>
              <path d="M13.7794 16.0003H10.7779C9.28266 16.0003 8.55737 15.2745 8.55737 13.7783V10.7747C8.55737 9.27851 9.28266 8.55273 10.7779 8.55273H13.7794C15.2746 8.55273 15.9999 9.27851 15.9999 10.7747V13.7783C15.9999 15.2745 15.2746 16.0003 13.7794 16.0003ZM10.7779 9.66931C9.90751 9.66931 9.67319 9.89262 9.67319 10.7747V13.7783C9.67319 14.6492 9.89636 14.8837 10.7779 14.8837H13.7794C14.6498 14.8837 14.8841 14.6604 14.8841 13.7783V10.7747C14.8841 9.90379 14.6609 9.66931 13.7794 9.66931H10.7779Z" fill="#111111"></path>
              <path d="M5.25478 7.43638H2.21975C0.72455 7.43638 -0.000732422 6.76644 -0.000732422 5.40422V2.03217C-0.000732422 0.669945 0.72455 0 2.21975 0H5.2213C6.7165 0 7.44179 0.669945 7.44179 2.03217V5.41539C7.44179 6.07416 7.27441 6.56546 6.92851 6.90043C6.56029 7.2689 6.0247 7.43638 5.25478 7.43638ZM2.21975 1.11657C1.22667 1.11657 1.11509 1.40688 1.11509 2.03217V5.40422C1.11509 6.04067 1.21551 6.31981 2.21975 6.31981H5.2213C5.68995 6.33098 6.00238 6.25282 6.13628 6.10766C6.25902 5.98484 6.31481 5.75036 6.31481 5.41539V2.03217C6.31481 1.40688 6.20323 1.11657 5.21015 1.11657H2.21975Z" fill="#111111"></path>
              <path d="M5.2213 16.0003H2.21975C0.72455 16.0003 -0.000732422 15.2745 -0.000732422 13.7783V10.7747C-0.000732422 9.27851 0.72455 8.55273 2.21975 8.55273H5.2213C6.7165 8.55273 7.44179 9.27851 7.44179 10.7747V13.7783C7.44179 15.2745 6.7165 16.0003 5.2213 16.0003ZM2.21975 9.66931C1.34941 9.66931 1.11509 9.89262 1.11509 10.7747V13.7783C1.11509 14.6492 1.33825 14.8837 2.21975 14.8837H5.2213C6.09164 14.8837 6.32597 14.6604 6.32597 13.7783V10.7747C6.32597 9.90379 6.1028 9.66931 5.2213 9.66931H2.21975Z" fill="#111111"></path>
            </svg>
          </a>
        </div>

        {%- if next_product -%}
          <div class="next-prev-wrapper">
            <a href="{{ next_product.url }}" class="next-prev-icon"> {% render 'right-arrow' %} </a>

            <div class="next-prev-tooltip">
              <div class="product_img">
                <img src="{{ next_product.featured_image | image_url: width: 80 }}" alt="{{ next_product.title }}">
              </div>
              <div class="product_detail">
                <a href="{{ product.title }}">{{ next_product.title }}</a>
                <p class="price">{{ next_product.price | money }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <section
    id="templateProduct-{{ section.id }}"
    class="section-{{ section.id }} section-spacing d-block color-{{ section.settings.color_scheme }} gradient top-bottom-spacing">
    {% liquid
      assign selected_variant = product.selected_or_first_available_variant
      assign featured_image = selected_variant.featured_image | default: product.featured_image
      assign slider_option = section.settings.slider_option
      assign thumbnail_position = section.settings.thumbnail_position
      assign thumbnail_type = section.settings.thumbnail_type
      assign media_placement = section.settings.media_position
      assign media_width = section.settings.media_width
    %}
    {{ 'product-detail-page.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="{{- 'photoswipe.min.css' | asset_url -}}" media="print" onload="this.media='all'">
    {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
    {%- if first_3d_model -%}
      <link
        id="ModelViewerStyle"
        rel="stylesheet"
        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
        media="print"
        onload="this.media='all'"
      >
      <link
        id="ModelViewerOverride"
        rel="stylesheet"
        href="{{ 'model-viewer-ui.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}

    <div
      class="productDetails {% if section.settings.full_width %}container-fluid px-3{% else %}container{% endif %} {{ section.settings.gallery_options }} product_{{ section.id }}"
    >
      {% if enable_sidebar %}
        <div class="row {% if sidebar-position == 'right' %}flex-row-reverse{% endif %}">
      {% endif %}
      {% comment %} sidebar start {% endcomment %}
      {% for block in section.blocks %}
        {% liquid
          assign menu = block.settings.menu
          assign items = block.settings.collection.products
          assign collection_item = block.settings.collection
        %}
        {% case block.type %}
          {% when 'sidebar' %}
            {% if block.settings.enable_sidebar %}
              <div class="sidebar col-lg-4 col-xxl-3">
                <button
                  class="facts__drawer d-block d-lg-none btn btn-secondary mb-4"
                  type="button"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#filtersOffcanvas"
                  aria-controls="filtersOffcanvas"
                  tabindex="0"
                >
                  {{ 'products.facets.filter_button' | t }}
                </button>

                <div
                  class="overflow-auto offcanvas offcanvas-start d-lg-none{% unless block.settings.sidebar_inherit_color_scheme %} color-{{ block.settings.sidebar_color_scheme }} {% else %} color-{{ settings.offcanvas_color_scheme }}{% endunless %}"
                  tabindex="-1"
                  id="filtersOffcanvas"
                  aria-labelledby="filtersOffcanvasLabel"
                  data-canvas-type="mobile"
                >
                  <div class="offcanvas-header border-bottom  justify-content-between">
                    <h3 class="offcanvas-title" id="filtersOffcanvasLabel">
                      {{ 'products.facets.filter_button' | t }}
                    </h3>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close">
                      {% render 'cancel.svg' %}
                    </button>
                  </div>

                  <div class="offcanvas-body blog-card spacing-style d-flex flex-column h-100 w-100">
                    {% render 'product-sidebar',
                      settings: block.settings,
                      children: children,
                      menu: menu,
                      products: items,
                      collection_item: collection_item,
                      enable_wishlist: settings.enable_wishlist,
                      enable_compare: settings.enable_compare,
                      enable_quickview: settings.enable_quickview
                    %}
                  </div>
                </div>

                {% if block.settings.enable_sidebar %}
                  <aside
                    class="sidebar border-style d-none d-lg-block{% if block.settings.sidebar_border == 'solid' %} p-lg-4 {% endif %} {% unless block.settings.sidebar_inherit_color_scheme %} color-{{ block.settings.sidebar_color_scheme }} p-lg-4 {% endunless %}"
                    style="
                        --border-width: {{ block.settings.sidebar_border_width }}px;
                        --border-style: {{ block.settings.sidebar_border }};
                        --border-color: rgba(var(--color-border), {{ block.settings.sidebar_border_opacity | divided_by: 100.0 }});
                      {% if block.settings.sidebar_border == 'solid' or block.settings.sidebar_inherit_color_scheme != true %}
                        --border-radius:{{ block.settings.sidebar_border_radius }}px;
                        {% endif %}
                    "
                    {{ block.shopify_attributes }}
                  >
                    {%
                      render 'product-sidebar',
                      settings: block.settings,
                      children: children,
                      menu: menu,
                      products: items,
                      collection_item: collection_item,
                      enable_wishlist: settings.enable_wishlist,
                      enable_compare: settings.enable_compare,
                      enable_quickview: settings.enable_quickview,
                      attribute
                    %}
                  </aside>
                {% endif %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}

      {% comment %} sidebar end {% endcomment %}

      <div
        class="{% if enable_sidebar %}col-lg-8 col-xxl-9{% endif %} row product product--large product--thumbnail_slider product--mobile-{{ section.settings.mobile_thumbnails }} media_position-{{ media_placement }} m-0 {% if section.settings.description_placement == 'bottom' %} mb-5 {% endif %}"
      > 
           <div
          class="{% if slider_option == 'modern_view' %} col-6 col-md-6 col-md-6  {% else %} col-6 col-md-6 col-md-6 {% endif %} m-lg-0  slider-option-{{ slider_option }}"
        > 
            <a
              class="skip-to-content-link button visually-hidden quick-add-hidden btn btn-primary"
              href="#ProductInfo-{{ section.id }}"
            >
              {{ 'accessibility.skip_to_product_info' | t }}
            </a>

            {% render 'product-detail-medias'
              product: product,
              featured_image: featured_image,
              direction: slider_option,
              thumbnail_type: thumbnail_type,
              thumbnail_position: thumbnail_position,
              placement_selector: 'nav-collection-list nav_right',
              selected_variant: product.selected_or_first_available_variant.image.id,
              style: section.settings.style,
              nav_style: section.settings.nav_style,
              settings: section.settings,
              promo_tag: product.metafields.custom.cuatom_tag,
              badge_radius: settings.badge_radius,
              badge_text: settings.badge_testcase,
              gallery_layout: slider_option
            %}
          </div> 
          
        <div data-section-id="{{ section.id }}"
          id="product-details-{{ section.id }}" data-producturl="{{ product.url }}"
          class="product-info col-12 {% if media_width == 'small' %} col-lg-7 {% elsif media_width == 'medium' %} col-md-6 {% else %} col-lg-5 {% endif %}  m-md-auto m-lg-0 product__info-wrapper {% if section.settings.mobile_thumbnails != 'hide' %} pt-4 {% else %} pt-0 {% endif %} pt-sm-5 pt-md-0   {% if media_placement == 'left' %} ps-md-3 ps-xxl-4 pe-0 ps-0 {% else %} pe-lg-3 pe-xxl-4 pe-0 ps-0 {% endif %}"
        >
          <div class="product-details top-5 p-0 accordion" id="toggle">
            {% render 'product-details-form', product: product, selected_variant: product.selected_or_first_available_variant %}            
          </div>
        </div>
      </div>
      <!-- ---------------------------- -->
      {% if section.settings.enable_sidebar %}
        </div>
      {% endif %}
      <!-- DESCRIPTION BOTTOM -->
      <!-- Description: canvas | defalut | collaspe style and Accordion here -->
      {%- if section.settings.description_placement == 'bottom' -%}
        <div class="accordion" id="toggles">
          {% for block in section.blocks %}
            {% case block.type %}
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  {%- if block.settings.description_type == 'canvas' -%}
                    <div class="canvas_block  d-inline-flex mt-3" {{ block.shopify_attributes }}>
                      <button
                        class="btn btn-primary"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvas-{{ block.id }}-{{ section.id }}"
                        aria-controls="offcanvas-{{ block.id }}-{{ section.id }}"
                      >
                        {{ 'products.product.description' | t }}
                      </button>
                    </div>
                  {%- elsif block.settings.description_type == 'collapse' -%}
                    <div class="accordion-item accordion--{{ block.id }}" {{ block.shopify_attributes }}>
                      <h2 class="accordion-header" id="heading-{{ block.id }}-{{ section.id }}">
                        <button
                          class="accordion-button collapsed px-0"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapse-{{ block.id }}-{{ section.id }}"
                          aria-controls="collapse-{{ block.id }}-{{ section.id }}"
                        >
                          <span class="{{ block.settings.type_preset }} mb-0">
                            {{ 'products.product.description' | t }}
                          </span>
                        </button>
                      </h2>
                      <div
                        class="accordion-collapse collapse"
                        id="collapse-{{ block.id }}-{{ section.id }}"
                        aria-labelledby="heading-{{ block.id }}-{{ section.id }}"
                        data-bs-parent="#toggles"
                      >
                        <div class="rte accordion-body pb-0 pt-3">
                          <div class="accordion__content pb-3">
                            {{ product.description }}
                          </div>
                        </div>
                      </div>
                    </div>

                  {%- elsif block.settings.description_type == 'default' -%}
                    <div class="rte product__description my-3" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- when 'accordion_panel' -%}
                <div class="accordion-item accordion--{{ block.id }}" {{ block.shopify_attributes }}>
                  <h2 class="accordion-header" id="heading-{{ block.id }}-{{ section.id }}">
                    <button
                      class="accordion-button collapsed px-0"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#collapse-{{ block.id }}-{{ section.id }}"
                      aria-controls="collapse-{{ block.id }}-{{ section.id }}"
                    >
                      <span class="{{ block.settings.type_preset }} mb-0">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}
                      </span>
                    </button>
                  </h2>
                  <div
                    class="accordion-collapse collapse"
                    data-bs-parent="#toggles"
                    id="collapse-{{ block.id }}-{{ section.id }}"
                    aria-labelledby="heading-{{ block.id }}-{{ section.id }}"
                  >
                    <div class="rte accordion-body px-0 pb-0 pt-3">
                      <div class="accordion__content rte pb-3">
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                      </div>
                    </div>
                  </div>
                </div>
            {% endcase %}
          {% endfor %}

          <!-- DESCRIPTION BOTTOM -->
          <!-- Description and TAb content heading -->
          <div class="product__info-bottom mt-3 tabs d-md-flex d-none gap-2">
            {% for block in section.blocks %}
              {% case block.type %}
                {%- when 'description' -%}
                  {%- if product.description != blank and block.settings.description_type == 'tab' -%}
                    <div class="tablinks" data-id="tab-{{ tab_index }}">
                      <button class="btn btn-primary">
                        {{ 'products.product.description' | t }}
                      </button>
                    </div>
                  {%- endif -%}

                {%- when 'tab_content' -%}
                  <div
                    class="tab_content_header tsb tablinks"
                    data-id="tab-{{ tab_index }}"
                    {{ block.shopify_attributes }}
                  >
                    <button class="btn btn-primary">
                      {{ block.settings.heading | default: block.settings.page.title | escape }}
                    </button>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

          <!-- DESCRIPTION BOTTOM -->
          <!-- Description tab style | tab content -->
          {% for block in section.blocks %}
            {% case block.type %}
              {%- when 'description' -%}
                {%- if product.description != blank and block.settings.description_type == 'tab' -%}
                  <div class="accordion-item border-0">
                    <h2
                      class="acc__title accordion-header d-block d-md-none"
                      id="heading-{{ block.id }}-{{ section.id }}"
                    >
                      <button
                        class="accordion-button collapsed px-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-{{ block.id }}-{{ section.id }}"
                        aria-controls="collapse-{{ block.id }}-{{ section.id }}"
                      >
                        <span class="{{ block.settings.type_preset }} mb-0">
                          {{ 'products.product.description' | t }}
                        </span>
                      </button>
                    </h2>
                    <div
                      class="dt-sc-tabs-content accordion-collapse collapse"
                      data-bs-parent="#toggles"
                      id="collapse-{{ block.id }}-{{ section.id }}"
                      aria-labelledby="heading-{{ block.id }}-{{ section.id }}"
                    >
                      <div class="rte accordion-body px-0 pb-0 pt-3">
                        <div class="accordion__content rte pb-3">
                          {{ product.description }}
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- when 'tab_content' -%}
                <div class="accordion-item border-0">
                  <h2
                    class="acc__title accordion-header d-block d-md-none"
                    id="heading-{{ block.id }}-{{ section.id }}"
                  >
                    <button
                      class="accordion-button collapsed px-0"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#collapse-{{ block.id }}-{{ section.id }}"
                      aria-controls="collapse-{{ block.id }}-{{ section.id }}"
                    >
                      <span class="h4 mb-0">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}
                      </span>
                    </button>
                  </h2>
                  <div
                    class="dt-sc-tabs-content accordion-collapse collapse"
                    data-bs-parent="#toggles"
                    id="collapse-{{ block.id }}-{{ section.id }}"
                    aria-labelledby="heading-{{ block.id }}-{{ section.id }}"
                  >
                    <div class="rte accordion-body px-0 pb-0 pt-3">
                      <div class="accordion__content rte pb-3">
                        {{ block.settings.content | strip_html }}
                        {{ block.settings.page.content }}
                      </div>
                    </div>
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

       {%- if section.settings.gallery_options == 'outer_zoom' %}
            <div class="outer-zoom-preview" style="display: none;">
        <img src="" alt="Zoom preview">
      </div>
      {% endif %}
    </div>
    {% render 'enquiry-form' %}

    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>

    {{ 'photoswipe-lightbox.umd.min.js' | asset_url | script_tag }}
    {{ 'photoswipe.umd.min.js' | asset_url | script_tag }}
    <script> 
    document.addEventListener('DOMContentLoaded', function () {

    {% if section.settings.gallery_options == 'photoswipe_lightbox' %} 
          const galleryEl = document.querySelector('#pswp-gallery-{{ section.id }}');
          if (!galleryEl) return;

          const items = [];
          galleryEl.querySelectorAll('a[data-pswp-width]').forEach(function(el) {
            items.push({
              src: el.getAttribute('href'),
              width: parseInt(el.getAttribute('data-pswp-width')),
              height: parseInt(el.getAttribute('data-pswp-height')),
              thumb: el.querySelector('img') ? el.querySelector('img').src : ''
            });
          });

          const lightbox = new PhotoSwipeLightbox({
            gallery: '#pswp-gallery-{{ section.id }}',
            children: 'a[data-pswp-width]',
            pswpModule: PhotoSwipe, 
            bgOpacity: 0.9, 
            padding: { top: 0, bottom: 100, left: 0, right: 0 },
            zoom: false
          });

          //PhotoSwipe UI          
          lightbox.on('uiRegister', function() {
            lightbox.pswp.ui.registerElement({
              name: 'thumbnails-strip',
              order: 9,
              isButton: false,
              appendTo: 'root',
              html: '',
              onInit: function(el, pswp) {
          
                el.classList.add('pswp-thumbnails');
                el.setAttribute('role', 'tablist');
                el.setAttribute('aria-label', 'Image thumbnails');

                items.forEach(function(item, index) {
                  const thumbEl = document.createElement('div');
                  thumbEl.classList.add('pswp-thumbnails__item');
          
                  thumbEl.setAttribute('role', 'tab');
                  thumbEl.setAttribute('tabindex', '0');
                  thumbEl.setAttribute('aria-label', 'Image ' + (index + 1) + ' of ' + items.length);
                  thumbEl.setAttribute('aria-selected', index === pswp.currIndex ? 'true' : 'false');

                  if (index === pswp.currIndex) {
                    thumbEl.classList.add('pswp-thumbnails__item--active');
                  }

                  const img = document.createElement('img');
                  img.src = item.thumb;
                  img.alt = '';                   
                  img.setAttribute('aria-hidden', 'true'); 
                  thumbEl.appendChild(img);
          
                  thumbEl.addEventListener('click', function() {
                    pswp.goTo(index);
                  });
          
                  thumbEl.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                      e.preventDefault();
                      pswp.goTo(index);
                    } 
                    if (e.key === 'ArrowRight') {
                      e.preventDefault();
                      const next = el.querySelectorAll('.pswp-thumbnails__item')[index + 1];
                      if (next) next.focus();
                    }
                    if (e.key === 'ArrowLeft') {
                      e.preventDefault();
                      const prev = el.querySelectorAll('.pswp-thumbnails__item')[index - 1];
                      if (prev) prev.focus();
                    }
                  });

                  el.appendChild(thumbEl);
                }); 
                pswp.on('change', function() {
                  el.querySelectorAll('.pswp-thumbnails__item').forEach(function(t, i) {
                    const isActive = i === pswp.currIndex;
                    t.classList.toggle('pswp-thumbnails__item--active', isActive);
                    t.setAttribute('aria-selected', isActive ? 'true' : 'false');
                  });
          
                  const activeThumb = el.querySelectorAll('.pswp-thumbnails__item')[pswp.currIndex];
                  if (activeThumb) {
                    activeThumb.scrollIntoView({
                      behavior: 'smooth',
                      inline: 'center',
                      block: 'nearest'
                    });
                  }
                });
              }
            });
          });

          lightbox.init();

        {% endif %}

        window.product = {{ product | json }};
      });
    </script>

    {%- if section.settings.gallery_options == 'inner_zoom_square'
      or section.settings.gallery_options == 'inner_zoom'
    -%}
      <script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
    {% endif %} 
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </section>
  {{- 'recently-viewed.js' | asset_url | script_tag -}}
<script>
  RecentlyViewed.addProduct({{ product.handle | json }});
</script>
</product-template>



