<script>
  document.querySelectorAll('.outer-zoom-image').forEach((img) => {
  const zoomPreview = document.querySelector('.outer-zoom-preview img');
  const zoomContainer = document.querySelector('.outer-zoom-preview');

  img.addEventListener('mouseenter', () => {
    zoomPreview.src = img.dataset.zoomImage;
    zoomPreview.style.transform = 'scale(5)';
    zoomContainer.style.display = 'block';
  });

  img.addEventListener('mousemove', (e) => {
    const rect = img.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    zoomPreview.style.transformOrigin = `${x}% ${y}%`;
  });

  img.addEventListener('mouseleave', () => {
    zoomPreview.style.transform = 'scale(1)';
    zoomContainer.style.display = 'none';
    
  });
});


</script>
<script>
  (function() {
    var key = 'viewedProducts';
    var handle = {{ product.handle | json }};
    try {
      var raw = JSON.parse(localStorage.getItem(key) || '[]');
      raw = raw.filter(function(h) { return h !== handle; });
      raw.unshift(handle);
      raw = raw.slice(0, 20);
      localStorage.setItem(key, JSON.stringify(raw));
    } catch(e) {}
  })();
</script>

 
