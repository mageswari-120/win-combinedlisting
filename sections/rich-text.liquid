{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign vartical_alignment = section.settings.vartical_alignment
%}

{% style %}
  .rich-text{ position: relative;}
  .rich_text_section.rich_text_section--{{ section.id }} .section_container{
    position:relative;
    width:100%;
    height:100%;
    min-height:var(--section-min-height, auto);
  }
  @media(min-width:992px){
    .rich_text_section.rich_text_section--{{ section.id }} .section_container{
         width:{{ section.settings.container_width }}%;
    }
  }
{% endstyle %}
<div class="color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}">
  <div
    class="rich_text_section rich_text_section--{{ section.id }} top-bottom-spacing {% if section.settings.full_width %}container-fluid {% else %}container{% endif %}"
    style="
       --padding-top:{{ section.settings.padding-block-start }}px;
      --padding-bottom:{{ section.settings.padding-block-end }}px;
    "
  >
    <div
      class="layout_height z-1 gap-style text-{{ vartical_alignment }}"
      style="justify-items:{{ vartical_alignment }}"
       {% if settings.animation != blank %}
        data-aos="{{ settings.animation}}"
       {% endif %}
    >
      <div class="section_container">
        {{ children }}
      </div>
    </div>
  </div>
</div>

{% comment %} [START section.blocks] {% endcomment %}
{% schema %}
{
  "name": "t:name.rich-text",
  "class": "rich-text",
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "button" }],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "vartical_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "t:settings.content_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.custom_class"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:settings.custom_class"
    }
  ],
  "presets": [
    {
      "name": "t:name.rich-text",
      "settings": {
        "color_scheme": "scheme-1",
        "vartical_alignment": "center",
        "padding-block-start": 100,
        "padding-block-end": 100
      },
      "blocks": [
        {
          "type": "text",
          "name": "t:name.heading",
          "settings": {
            "text": "<h2>Talk about your brand</h2>",
            "padding-block-end": 16
          }
        },
        {
          "type": "description",
          "name": "t:settings.text",
          "settings": {
            "text": "Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.",
            "padding-block-end": 16
          }
        },
        {
          "type": "button",
          "name": "t:name.button"
        }
      ]
    }
  ]
}
{% endschema %}
