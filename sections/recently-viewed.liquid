{% stylesheet %}
  .recently-viewed {
    padding: 2rem 1.5rem;
  }

  .recently-viewed__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .recently-viewed__clear {
    border: none;
    background: none;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .recently-viewed__empty {
    color: rgba(0, 0, 0, 0.6);
  }

  .rv-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .rv-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .rv-card__title {
    margin: 0.5rem 0 0.25rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .rv-card__price {
    margin: 0;
    font-size: 0.9rem;
  }

  .rv-card__compare {
    display: none;
    margin: 0;
    font-size: 0.85rem;
    text-decoration: line-through;
    opacity: 0.6;
  }
{% endstylesheet %}

<template data-recently-viewed-template>
  <div class="swiper-slide">
    <a data-rv-url href="#" class="rv-card">
      <img data-rv-image src="" alt="" loading="lazy">
      <p class="rv-card__title" data-rv-title></p>
      <p class="rv-card__price" data-rv-price></p>
      <p class="rv-card__compare" data-rv-compare></p>
    </a>
  </div>
</template>

<section
  class="recently-viewed"
  aria-labelledby="recently-viewed-heading-{{ section.id }}"
  data-recently-viewed
  data-max-items="{{ section.settings.max_items | default: 8 }}"
>
  <div class="recently-viewed__header">
    <h2 id="recently-viewed-heading-{{ section.id }}">
      Recently viewed
    </h2>
    <button type="button" class="recently-viewed__clear" data-recently-viewed-clear>
      Clear
    </button>
  </div>

  <div data-recently-viewed-grid>
    <p class="recently-viewed__empty">No recently viewed products</p>
  </div>
</section>

<script>
  (function() {
    var STORAGE_KEY = 'viewedProducts';

    function getHandles() {
      try {
        var raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        return raw
          .map(function(h) { return String(h).replace(/^"|"$/g, '').trim(); })
          .filter(function(h, i, arr) { return h && arr.indexOf(h) === i; });
      } catch (e) {
        return [];
      }
    }

    function saveHandles(handles) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(handles));
    }

    function formatMoney(cents) {
      return (cents / 100).toLocaleString('en-IN', {
        style: 'currency',
        currency: 'INR'
      });
    }

    function renderProduct(product) {
      var template = document.querySelector('[data-recently-viewed-template]');
      var clone = template.content.cloneNode(true);

      clone.querySelector('[data-rv-url]').href = '/products/' + product.handle;

      var img = clone.querySelector('[data-rv-image]');
      if (product.featured_image) {
        img.src = product.featured_image;
        img.alt = product.title;
      } else {
        img.remove();
      }

      clone.querySelector('[data-rv-title]').textContent = product.title;
      clone.querySelector('[data-rv-price]').textContent = formatMoney(product.price);

      var compare = clone.querySelector('[data-rv-compare]');
      if (product.compare_at_price_max > product.price) {
        compare.textContent = formatMoney(product.compare_at_price_max);
        compare.style.display = '';
      }

      var wrapper = document.createElement('div');
      wrapper.appendChild(clone);
      return wrapper.innerHTML;
    }

    async function fetchProduct(handle) {
      try {
        var res = await fetch('/products/' + handle + '.js');
        if (!res.ok) return null;
        return await res.json();
      } catch (e) {
        return null;
      }
    }

    async function renderGrid(grid, maxItems) {
      var handles = getHandles().slice(0, maxItems);

      if (!handles.length) {
        grid.innerHTML = '<p class="recently-viewed__empty">No recently viewed products</p>';
        return;
      }

      grid.innerHTML = '<p class="recently-viewed__empty">Loading...</p>';

      var products = await Promise.all(handles.map(fetchProduct));
      var valid = products.filter(Boolean);

      if (!valid.length) {
        grid.innerHTML = '<p class="recently-viewed__empty">No recently viewed products</p>';
        return;
      }

      // Build swiper structure
      grid.innerHTML = `
        <div class="swiper recently-viewed__swiper">
          <div class="swiper-wrapper">
            ${valid.map(renderProduct).join('')}
          </div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
          <div class="swiper-pagination"></div>
        </div>
      `;

      // Init Swiper — reuse existing instance if Swiper is loaded
      if (typeof Swiper !== 'undefined') {
        new Swiper('.recently-viewed__swiper', {
          slidesPerView: 2,
          spaceBetween: 16,
          navigation: {
            nextEl: '.recently-viewed__swiper .swiper-button-next',
            prevEl: '.recently-viewed__swiper .swiper-button-prev',
          },
          pagination: {
            el: '.recently-viewed__swiper .swiper-pagination',
            clickable: true,
          },
          breakpoints: {
            640: { slidesPerView: 3 },
            1024: { slidesPerView: 4 },
          }
        });
      }
    }

    function initRecentlyViewed() {
      var sections = document.querySelectorAll('[data-recently-viewed]');
      if (!sections.length) return;

      sections.forEach(function(sectionEl) {
        var grid = sectionEl.querySelector('[data-recently-viewed-grid]');
        var clearBtn = sectionEl.querySelector('[data-recently-viewed-clear]');
        var maxItems = parseInt(sectionEl.dataset.maxItems, 10) || 8;

        if (!grid) return;

        renderGrid(grid, maxItems);

        if (clearBtn) {
          clearBtn.addEventListener('click', function() {
            saveHandles([]);
            grid.innerHTML = '<p class="recently-viewed__empty">No recently viewed products</p>';
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRecentlyViewed);
    } else {
      initRecentlyViewed();
    }
  })();
</script>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum items",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}