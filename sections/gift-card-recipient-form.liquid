{%- assign gift_card_recipient_control_flag = 'properties[__shopify_send_gift_card_to_recipient]' -%}
<recipient-form
  class="recipient-form position-relative"
  data-section-id="{{ section.id }}"
  data-product-variant-id="{{ product.selected_or_first_available_variant.id }}"
>
  <div
    class="receipient__form align-items-center gap-2 collapsed unload-recipient d-none"
    href="#receipient"
    data-bs-toggle="collapse"
    aria-expanded="true"
    aria-controls="receipient"
  >
    <input
      id="Recipient-checkbox-{{ section.id }}"
      type="checkbox"
      name="{{ gift_card_recipient_control_flag }}"
    >
    <label for="Recipient-checkbox-{{ section.id }} visually-hidden" class="m-0">{{ 'recipient.form.checkbox' | t }}</label>
  </div> 
  <ul>  
    {%- if form.errors -%}
      {%- for field in form.errors -%}
        <li>
          {%- if field == 'form' -%}
            {{ form.errors.messages[field] }}
          {%- else -%}
            <a href="#Recipient-{{ field }}-{{ section.id }}">
              {{ form.errors.messages[field] }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  <div class="gift-card-form collapse show" id="receipient">
   <div id="email-error-message" class="text-danger mb-3"></div>
    <div class="mb-3">
      <label for="giftCardRecipientName" class="gift_card_label form-label h4 mb-3">{{ 'recipient.form.name_label' | t }}</label>
      <input
        type="text"
        name="properties[Recipient Name]"
        id="giftCardRecipientName"
        class="form-control"
        required
        placeholder="{{ 'recipient.form.name' | t }}"
        value="{{ form.name }}"
      >
    </div>
     <div class="mb-3">
      <label for="giftCardRecipientEmail" class="gift_card_label form-label h4 mb-3">{{ 'recipient.form.email_label' | t }}*</label>    
     <input
            class="form-control"
            id="Recipient-email-{{ section.id }}"
            type="email"
            placeholder="{{ 'recipient.form.email' | t }}"
            name="properties[Recipient email]"
            pattern="^([a-zA-Z0-9_\-\+\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,9})$"
            value="{{ form.email }}"
            {% if form.errors contains 'email' %}
              aria-invalid="true"              
            {% endif %}
          >
    </div>

    <div class="mb-3">
      <label for="giftCardMessage" class="gift_card_label form-label h4 mb-3">{{ 'recipient.form.message_label' | t }}</label>
      <textarea
        name="properties[Message]"
        id="giftCardMessage"
        rows="4"
        class="form-control"
        placeholder="{{ 'recipient.form.message_label' | t }}"
      ></textarea>
    </div>

    <div class="mb-3">
      <div id="sendon-error" class="text-danger mb-3"></div>
      <label for="giftCardMessage" class="gift_card_label form-label h4 mb-3">{{ 'recipient.form.send_on_label' | t }}</label>
      <input
        id="giftCardSendon"
        class="form-control"
        type="date"
        name="properties[Send on]"
        placeholder="{{ 'recipient.form.send_on' | t }}"
        pattern="\d{4}-\d{2}-\d{2}"
        min="{{ 'now' | date: '%Y-%m-%d' }}"
        value="{{ form.send_on }}"
      >
    </div>

    <input
      type="hidden"
      name="{{ gift_card_recipient_control_flag }}"
      value="if_present"
      id="Recipient-control-{{ section.id }}"
    >
    <input
      type="hidden"
      name="properties[__shopify_offset]"
      value=""
      id="Recipient-timezone-offset-{{ section.id }}"
      disabled
    >
  </div>
</recipient-form>

