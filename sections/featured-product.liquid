{% style %}
  .mainProduct .variant-option-item.selected{
      border:{{ settings.variant_swatch_border_width }}px solid rgba(var(--color-primary-button-border),{{settings.variant_swatch_border_opacity | divided_by: 100.0}}) !important;
       padding:4px;
      }
      .mainProduct .variant-options .variant-option-item{
        border-radius: {{ settings.variant_swatch_radius }}px;
      }
  {% if section.settings.show_sticky  %}
   @media (min-width: 992px) {
    .section-{{ section.id }} .mainProduct .product__media-wrapper,
    .section-{{ section.id }} .mainProduct .product__info-wrapper {
      position: sticky;
      height: max-content;
      top: 0;
    }
   }
  {% endif %}
  .share_button  svg{ flex: 0 0 auto;}
  .mainProduct .form-label{cursor:default;}
  .mainProduct .model_text{cursor:pointer;}
   @media (max-width: 576px) {
  .mainProduct .product--thumbnail_slider.product--mobile-show .swiper-navigation.nav-collection-list,
  .mainProduct .product--thumbnail_slider.product--mobile-hide .swiper-navigation.nav-collection-list{
    margin-top:0px;
    margin-bottom:0px;
    justify-content: center;
    gap: 2rem;
  }
  .mainProduct .product--thumbnail_slider.product--mobile-show .swiper-navigation.nav-collection-list .navigation_button,
  .mainProduct .product--thumbnail_slider.product--mobile-hide .swiper-navigation.nav-collection-list .navigation_button {
    margin:0;
    left:0;
  }

   }
             .product_{{ section.id }} .product-media-gallery .product_media .product-video_main iframe,
             .product_{{ section.id }} .mainProduct video,
             .product_{{ section.id }}.mainProduct .product-media-gallery .swiper-slide,
             .product_{{ section.id }}.mainProduct  svg.placeholder-svg {
             {% if section.settings.media_border != 'none' %}
             border: {{section.settings.media_border_width}}px {{section.settings.media_border}} rgba(var(--bs-border-color),{{section.settings.media_border_opacity | divided_by: 100.0}});
             {% endif %}
             border-radius: {{section.settings.media_border_radius}}px;
             }

             .product_{{ section.id }} .thumbnail-slide.swiper-slide-thumb-active img{
             {% if section.settings.media_border != 'none' %}
             border: {{section.settings.media_border_width}}px {{section.settings.media_border}} rgba(var(--bs-border-color),{{section.settings.media_border_opacity | divided_by: 100.0}});
             {% else %}
              border: 2px solid rgba(var(--bs-border-color),{{section.settings.media_border_opacity | divided_by: 100.0}});
             {% endif %}
             }
             .product_{{ section.id }} .thumbnail-slide img{
               border-radius: {{section.settings.media_border_radius | divided_by: 2 }}px;
             }



      {% for block in section.blocks %}
          .accordion .accordion--{{ block.id }}{
              {% if block.settings.dividers %}
              --bs-accordion-border-width:1px;
              {% else %}
              --bs-accordion-border-width:0px;
              {% endif %}
              {% if block.settings.accordion_icon == 'caret' %}
              --bs-accordion-plus-icon:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="%23000000" height="14px" width="14px" version="1.1" id="Layer_1" viewBox="0 0 491.996 491.996" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><g><g><path d="M484.132,124.986l-16.116-16.228c-5.072-5.068-11.82-7.86-19.032-7.86c-7.208,0-13.964,2.792-19.036,7.86l-183.84,183.848 L62.056,108.554c-5.064-5.068-11.82-7.856-19.028-7.856s-13.968,2.788-19.036,7.856l-16.12,16.128 c-10.496,10.488-10.496,27.572,0,38.06l219.136,219.924c5.064,5.064,11.812,8.632,19.084,8.632h0.084 c7.212,0,13.96-3.572,19.024-8.632l218.932-219.328c5.072-5.064,7.856-12.016,7.864-19.224 C491.996,136.902,489.204,130.046,484.132,124.986z"></path></g></g></g></svg>');
              --bs-accordion-btn-active-icon:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="%23000000"> <path d="M480-528 296-344l-56-56 240-240 240 240-56 56-184-184Z" /> </svg>');
              --transform:rotate(0deg);
              --bs-accordion-btn-icon-width:10px;
              --bs-accordion-btn-icon-height:8px;
              {% elsif block.settings.accordion_icon == 'plus' %}
              --bs-accordion-btn-icon-width:12px;
              --bs-accordion-btn-icon-height:1px;
              --bs-accordion-plus-icon:none;
              --transform:rotate(90deg);
              {% endif %}
              }
       {% endfor %}

         .product_{{ section.id }} .accordion-button::after {
  flex-shrink: 0;
  width: var(--bs-accordion-btn-icon-width);
  height: var(--bs-accordion-btn-icon-height);
  margin-left: auto;
  content: "";
  /* background-image: var(--bs-accordion-btn-icon);
  background-repeat: no-repeat;
  background-size: var(--bs-accordion-btn-icon-width); */
  mask-image: var(--bs-accordion-plus-icon);
  mask-repeat: no-repeat;
  mask-size:  cover;
  transition: var(--bs-accordion-btn-icon-transition);
  background-color:rgb(var(--color-heading));
  transform:var(--transform);
}
.product_{{ section.id }} .accordion-button:before{
  width: var(--bs-accordion-btn-icon-width);
  height: var(--bs-accordion-btn-icon-height);
  margin-left: auto;
  mask-repeat: no-repeat;
  mask-size:  cover;
  mask-image: var(--bs-accordion-plus-icon);
  content: "";
  background-color:rgb(var(--color-heading));
}
.product_{{ section.id }} .accordion-button:not(.collapsed):before,
.product_{{ section.id }} .accordion-button:not(.collapsed):after
 {
    transform: rotate(180deg);
}
{% endstyle %}

<product-template>
  <section
    id="templateProduct-{{ section.id }}"
    class="section-{{ section.id }} section-spacing d-block color-{{ section.settings.color_scheme }} gradient spacing-style"
    style="{% render 'spacing-style',settings:section.settings %}"
  >
    {% liquid
      assign product = section.settings.product
      assign selected_variant = product.selected_or_first_available_variant
      assign featured_image = selected_variant.featured_image | default: product.featured_image
      assign slider_direction = section.settings.slider_option
      assign media_placement = section.settings.media_position
      assign nav_style = section.settings.nav_style
      assign media_aspect_ratio = section.settings.media_aspect_ratio
      assign media_width = section.settings.media_width
    %}
    <link rel="stylesheet" href="{{- 'photoswipe.min.css' | asset_url -}}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
    {{ 'product-detail-page.css' | asset_url | stylesheet_tag }}
    <div class="mainProduct {% if section.settings.full_width %}container-fluid{% else %}container{% endif %} product_{{ section.id }}">
      <div class="row product product--large product--thumbnail_slider product--mobile-{{ section.settings.mobile_thumbnails }} media_position-{{ media_placement }} g-4 m-0">
        <div
          class="col-md-12 mt-0 {% if media_width == 'small' %} col-lg-4 {% elsif media_width == 'medium' %} col-lg-6 {% else %} col-lg-7 {% endif %} product__media-wrapper {% if media_placement == 'left' %}  pe-lg-3 pe-xxl-4{% else %} ps-lg-3 ps-xxl-4 {% endif %} slider-option-{{ slider_direction }}"
          {% if settings.animation != blank %}
            data-aos="{{ settings.animation}}" data-aos-delay="{{ delay }}"
          {% endif %}
        >
          {% if product.media.size > 0 %}
            {% render 'product-detail-medias',
              product: product,
              featured_image: featured_image,
              direction: slider_direction,
              style: section.settings.style,
              nav_style: section.settings.nav_style,
              media_aspect_ratio: media_aspect_ratio,
              media_width: media_width,
              settings: section.settings,
              promo_tag: product.metafields.custom.cuatom_tag,
              badge_color: settings.sale_color_scheme,
              badge_radius: settings.badge_radius,
              badge_text: settings.badge_testcase,
              placement_selector: 'nav-collection-list nav_right',
              selected_variant: product.selected_or_first_available_variant.image.id
            %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="col-md-12 mt-0{% if media_width == 'small' %} col-lg-8 {% elsif media_width == 'medium' %} col-lg-6 {% else %} col-lg-5 {% endif %} product__info-wrapper product-info pt-3 pt-lg-0 {% if media_placement == 'left' %} ps-lg-3 ps-xxl-4{% else %} pe-lg-3 pe-xxl-4{% endif %} ">
          <div
            class="product--information top-5 p-0 accordion"
            id="toggle"
            {% if settings.animation != blank %}
              data-aos="{{ settings.animation}}" data-aos-delay="{{ delay }}"
            {% endif %}
          >
            {%- if product == null -%}
              {% render 'onboard-featured' %}
            {%- else -%}
              <main-product-form>
                {% form 'product', product, id: 'product-form', novalidate: 'novalidate', data-product-id: product.id %}
                  <input type="hidden" name="id" data-product-id="{{ product.id }}" value="{{ selected_variant.id }}">
                  {% for block in section.blocks %}
                    {% case block.type %}
                      {% when '@app' %}
                        <div class="mt-3 mb-2 w-100 product_block" {{ block.shopify_attributes }}>
                          {% render block %}
                        </div>
                      {% when 'vendor' %}
                        <div
                          class="qv-product_vendor top-bottom-spacing"
                          {{ block.shopify_attributes }}
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          <span class="product_vendor text-wrap">{{ product.vendor }}</span>
                        </div>

                      {% when 'title' %}
                        <div
                          class="product-title qv-product_title top-bottom-spacing"
                          {{ block.shopify_attributes }}
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          <h1 class="h3 m-0">
                            {{ product.title }}
                          </h1>
                        </div>

                      {%- when 'text' -%}
                        <div
                          class="product-text text-wrap top-bottom-spacing"
                          {{ block.shopify_attributes }}
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          <p class="m-0">{{- block.settings.text | strip_html -}}</p>
                        </div>

                      {% when 'price' %}
                        <div
                          class="price_block qv-price_block top-bottom-spacing"
                          id="price-{{ section.id }}"
                          {{ block.shopify_attributes }}
                          role="status"
                          aria-atomic="true"
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          {%- liquid
                            if settings.currency_code_enabled
                              assign money_main_price = selected_variant.price | money_with_currency
                              assign money_main_compare_price = selected_variant.compare_at_price | money_with_currency
                            else
                              assign money_main_price = selected_variant.price | money
                              assign money_main_compare_price = selected_variant.compare_at_price | money
                            endif
                          -%}
                          {{ form | payment_terms }}
                          {% if selected_variant.compare_at_price > selected_variant.price %}
                            <span class="price" data-price="{{ selected_variant.price }}">{{ money_main_price }}</span>
                            <span class="text-muted text-decoration-line-through compare_price">
                              {{- money_main_compare_price -}}
                            </span>
                          {% else %}
                            <span class="price" data-price="{{ selected_variant.price }}">{{ money_main_price }}</span>
                          {% endif %}
                          {% if selected_variant.unit_price %}
                            {{ selected_variant.unit_price | money }}
                            <span aria-hidden="true">/</span>
                            <span class="visually-hidden"
                              >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                            >
                          {% endif %}
                          <span class="product-unit-price">
                            {% if selected_variant.unit_price_measurement %}
                              {% if selected_variant.unit_price_measurement.reference_value != 1 %}
                                {{ selected_variant.unit_price_measurement.reference_value }}
                              {% endif %}
                              {{ selected_variant.unit_price_measurement.reference_unit }}
                            {% endif %}
                          </span>

                          {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                            <div class="product-tax-details">
                              {%- if cart.taxes_included -%}
                                {{ 'products.product.taxes_included' | t }}
                              {%- endif -%}
                              {%- if shop.shipping_policy.body != blank -%}
                                {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </div>

                      {% when 'variant_selector' %}
                        <div
                          class="variant_selector top-bottom-spacing"
                          {{ block.shopify_attributes }}
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          <variant-selector
                            data-url="{{ product.url }}"
                            data-section="{{ section.id }}"
                            role="status"
                            aria-atomic="true"
                          >
                            {% unless product.has_only_default_variant %}
                              {% for option in product.options_with_values %}
                                {%- assign name = 'option' | append: option.position -%}
                                {%- liquid
                                  assign option_maping_lable = settings.map_color_option | default: 'color' | downcase | split: ','
                                  assign option_name = option.name | handleize
                                  assign option_type = block.settings.swatch_style
                                  assign swatch_type = option_type
                                  if block.settings.color_swatch
                                    if option_maping_lable contains option_name
                                      assign swatch_type = 'color'
                                    endif
                                  endif
                                -%}
                                {% if block.settings.swatch_style == 'dropdown' %}
                                  <div class="swatch_dropdown variant-container {% unless forloop.last %}mb-4{% endunless %}">
                                    <div class="d-flex gap-1 selected-variant-display mb-2 pb-1">
                                      <label
                                        for="Option-{{ section.id }}-{{ forloop.index0 }}"
                                        class="form-label h6 m-0"
                                      >
                                        {{ option.name }} :
                                      </label>
                                      <span class="selected_variant">{{ option.selected_value }}</span>
                                    </div>
                                    <select
                                      name="options[{{ option.name | escape }}]"
                                      id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                      class="form-select"
                                    >
                                      {% for value in option.values %}
                                        <option
                                          class="items"
                                          value="{{ value | escape }}"
                                          {% if option.selected_value == value %}
                                            selected="selected"
                                          {% endif %}
                                        >
                                          <span>{{ '&nbsp;' | append: value | append: '&nbsp;' }}</span>
                                        </option>
                                      {% endfor %}
                                    </select>
                                  </div>
                                {% else %}
                                  {%- case swatch_type -%}
                                    {%- when 'color' -%}
                                      <div class="variant-container swatch-{{ swatch_type }} {% unless forloop.last %}mb-4{% endunless %}">
                                        <div class="d-flex gap-1 selected-variant-display mb-2 pb-1">
                                          <label
                                            for="Option-{{ section.id }}-{{ forloop.index0 }}"
                                            class="form-label h6 m-0"
                                          >
                                            {{ option.name }} :
                                          </label>
                                          <span class="selected_variant">{{ option.selected_value }}</span>
                                        </div>
                                        <ul
                                          class="variant-options p-0 d-flex flex-wrap gap-3"
                                          id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                          role="listbox"
                                          aria-label="{{ option.name | escape }}"
                                          data-option-name="{{ option.name | escape }}"
                                          data-option-index="{{ forloop.index0 }}"
                                        >
                                          {% for value in option.values %}
                                            {%- assign variant_for_value = product.variants
                                              | where: name, value
                                              | first
                                            -%}
                                            {%- assign opt_selected_value = option.selected_value | handleize -%}
                                            {%- assign opt_actual_value = value | handleize -%}
                                            <li
                                              class="variant-option-item {% unless value.available %}variant-unavailable{% endunless %} {% if opt_selected_value == opt_actual_value %}selected{% endif %} d-inline-flex align-items-center justify-content-center {% if block.settings.swatch_shape == 'circle' %} rounded-pill {% endif %}"
                                              data-value="{{ value | escape }}"
                                              data-swatch="{{ value }}"
                                              data-option-value="{{ option.name | escape }}"
                                              data-availability="{{ value.available}}"
                                              title="{{ value }}"
                                              role="option"
                                              aria-checked="{% if opt_selected_value == opt_actual_value %}true{% else %}false{% endif %}"
                                              aria-selected="{% if opt_selected_value == opt_actual_value %}true{% else %}false{% endif %}"
                                              style="
                                                width: {{ settings.variant_swatch_width }}px;
                                                  height: {{ settings.variant_swatch_height }}px;
                                                  display: flex;
                                                  align-items:center;
                                                  justify-content:center;
                                                  border-radius: {{ settings.variant_swatch_radius }}px;
                                                {% if settings.variant_swatch_border_width != 0 %} border:{{ settings.variant_swatch_border_width }}px solid rgba(var(--color-border),{{ settings.variant_swatch_border_opacity | divided_by: 100.0  }});
                                                   border-radius: {{ settings.variant_swatch_radius }}px; {% endif %}
                                              "
                                            >
                                              {% assign is_selected = selected_variant.options[forloop.index0].value %}
                                              <label
                                                for="option-{{ option.name | handleize }}-{{ value | handleize }}"
                                                class="swatch-option d-inline-flex align-items-center justify-content-center {% if is_selected %}active{% endif %}"
                                                style="
                                                   width: 100%;
                                                   height: 100%;
                                                  border-radius: {{ settings.variant_swatch_radius }}px;
                                                   {% if block.settings.show_variant_image_as_swatch %}
                                                   {% if variant_for_value.featured_media != blank  %}
                                                   background-image: url('{{ variant_for_value.featured_media | image_url:  width: 100 }}');
                                                   {% endif %}
                                                   {% else %}
                                                   {% if value.swatch.color or value.swatch.image -%}
                                                   background-color: {%- if value.swatch.color %}{{ value.swatch.color }}{%- endif -%};
                                                   background-image: {%- if value.swatch.image %}url('{{ value.swatch.image | image_url: width: 100 }}'){%- endif -%};
                                                   {% else %}
                                                   background-color: {{ value | handleize }};
                                                   {%- endif %}
                                                   {%- endif %}
                                                   background-size: cover;
                                                   background-position: center;
                                                   cursor: pointer;
                                                   border: var(--border-width) solid rgba(var(--bs-border-color),1);
                                                "
                                              >
                                                <input
                                                  type="radio"
                                                  name="options[{{ option.name }}]"
                                                  id="option-{{ option.name | handleize }}-{{ value | handleize }}"
                                                  value="{{ value }}"
                                                  class="d-none"
                                                  {% if is_selected %}
                                                    checked
                                                  {% endif %}
                                                >
                                                <span class="visually-hidden">{{ value }}</span>
                                              </label>
                                            </li>
                                          {% endfor %}
                                        </ul>
                                      </div>
                                    {%- when 'button' -%}
                                      <div
                                        class="variants variant-container {% unless forloop.last %}mb-4{% endunless %}"
                                        {{ block.shopify_attributes }}
                                      >
                                        <div class="d-flex selected-variant-display gap-1">
                                          <label
                                            for="Option-{{ section.id }}-{{ forloop.index0 }}"
                                            class="form-label selected-variant-display h6"
                                          >
                                            {{ option.name }} :
                                          </label>
                                          <span class="selected_variant">{{ option.selected_value }}</span>
                                        </div>
                                        <ul
                                          class="variant-options p-0 d-flex flex-wrap gap-3"
                                          role="listbox"
                                          aria-label="{{ option.name | escape }}"
                                          id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                          data-option-name="{{ option.name | escape }}"
                                          data-option-index="{{ forloop.index0 }}"
                                        >
                                          {% for value in option.values %}
                                            {%- assign opt_selected_value = option.selected_value | handleize -%}
                                            {%- assign opt_actual_value = value | handleize -%}
                                            <li
                                              class="variant-option-item {% unless value.available %}variant-unavailable{% endunless %} {% if opt_selected_value == opt_actual_value %}selected{% endif %} btn btn-secondary d-inline-block px-3 py-2 "
                                              data-value="{{ value | escape }}"
                                              data-swatch="{{ value }}"
                                              data-option-value="{{ option.name | escape }}"
                                              data-availability="{{ value.available}}"
                                              data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              data-bs-custom-class="custom-tooltip"
                                              title="{{ value }}"
                                              role="option"
                                              aria-checked="{% if opt_selected_value == opt_actual_value %}true{% else %}false{% endif %}"
                                              aria-selected="{% if opt_selected_value == opt_actual_value %}true{% else %}false{% endif %}"
                                            >
                                              <label
                                                for="option-{{ option.name | handleize }}-{{ value | handleize }}"
                                                class="swatch-option d-inline-flex align-items-center justify-content-center {% if opt_selected_value == opt_actual_value %}active{% endif %}"
                                              >
                                                {{- value }}
                                                <input
                                                  type="radio"
                                                  name="options[{{ option.name }}]"
                                                  id="option-{{ option.name | handleize }}-{{ value | handleize }}"
                                                  value="{{ value }}"
                                                  class="d-none"
                                                  {% if is_selected %}
                                                    checked
                                                  {% endif %}
                                                >
                                                <span class="visually-hidden">{{ value }}</span>
                                              </label>
                                            </li>
                                          {% endfor %}
                                        </ul>
                                      </div>
                                  {%- endcase -%}
                                {% endif %}
                              {% endfor %}
                            {% endunless %}
                            <script type="application/json" data-selected-variant>
                              {{ product.variants | json }}
                            </script>

                            <div class="product-variants-selector-select d-none">
                              {% for variant in product.variants %}
                                {% if variant.available %}
                                  <div
                                    {% if selected_variant.id == variant.id %}
                                      selected
                                    {% endif %}
                                    value="{{ variant.id }}"
                                    data-inventory-quantity="{{ variant.inventory_quantity }}"
                                    data-inventory-management="{{ variant.inventory_management }}"
                                    data-inventory-policy="{{ variant.inventory_policy }}"
                                    data-available="{{ variant.available }}"
                                  >
                                    {{ variant.title | escape }}
                                  </div>
                                {% else %}
                                  <div
                                    {% if selected_variant.id == variant.id %}
                                      selected
                                    {% endif %}
                                    disabled
                                    value="{{ variant.id }}"
                                    data-inventory-quantity="{{ variant.inventory_quantity }}"
                                    data-inventory-management="{{ variant.inventory_management }}"
                                    data-inventory-policy="{{ variant.inventory_policy }}"
                                    data-available="{{ variant.available }}"
                                  >
                                    {{ variant.title | escape }}
                                  </div>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </variant-selector>
                        </div>

                      {% when 'quantity' %}
                        <quantity-editor {{ block.shopify_attributes }}>
                          <div class="mb-3">
                            <label class="form-label w-100 h6" for="quantity-{{ section.id }}">
                              {{- 'products.product.quantity.label' | t -}}
                            </label>
                            <div class="quantity w-100 mb-0{% if section.settings.nav_style == 'modern' %} bg-transparent{% endif %}">
                              <button class="decrement-btn quantity__button" aria-label="decrement">
                                {% render 'icon-toggle-minus' %}
                              </button>
                              <input
                                type="number"
                                name="quantity"
                                class="form-control quantity-input"
                                value="1"
                                min="1"
                                {% if selected_variant.inventory_management != blank %}
                                  max="{{ selected_variant.inventory_quantity }}"
                                  data-max="{{ selected_variant.inventory_quantity }}"
                                {% endif %}
                                id="quantity-{{ section.id }}"
                              >
                              <button class="increment-btn quantity__button" aria-label="increment">
                                {% render 'icon-toggle-plus' %}
                              </button>
                            </div>
                          </div>
                        </quantity-editor>
                      {% when 'divider' %}
                        <div
                          class="divider_border"
                          {{ block.shopify_attributes }}
                          style="margin-top:{{ block.settings.padding-block-start }}px; margin-bottom:{{ block.settings.padding-block-end }}px;"
                        ></div>
                        <style>
                          .product_{{ section.id }} .divider_border {
                            width: 100%;
                            height: {{ block.settings.divider_border_width }}px;
                            background:rgba(var(--bs-border-color), {{ block.settings.border_opacity | divided_by : 100.0 }});
                            margin:20px 0;
                          }
                        </style>

                      {%- when 'description' -%}
                        {%- if product.description != blank -%}
                          {%- if block.settings.description_type == 'canvas' -%}
                            <div
                              class="canvas_block  d-inline-flex top-bottom-spacing"
                              {{ block.shopify_attributes }}
                              style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                            >
                              <button
                                class="btn btn-primary"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#offcanvas-{{ block.id }}-{{ section.id }}"
                                aria-controls="offcanvas-{{ block.id }}-{{ section.id }}"
                              >
                                {{ 'products.product.description' | t }}
                              </button>
                            </div>
                          {%- elsif block.settings.description_type == 'collapse' -%}
                            <div class="accordion-item accordion--{{ block.id }}" {{ block.shopify_attributes }}>
                              <h2 class="accordion-header" id="heading-{{ block.id }}-{{ section.id }}">
                                <button
                                  class="accordion-button collapsed px-0"
                                  type="button"
                                  data-bs-toggle="collapse"
                                  data-bs-target="#collapse-{{ block.id }}-{{ section.id }}"
                                  aria-controls="collapse-{{ block.id }}-{{ section.id }}"
                                >
                                  <span class="{{ block.settings.type_preset }} mb-0 ">
                                    {{ 'products.product.description' | t }}
                                  </span>
                                </button>
                              </h2>
                              <div
                                class="accordion-collapse collapse"
                                id="collapse-{{ block.id }}-{{ section.id }}"
                                aria-labelledby="heading-{{ block.id }}-{{ section.id }}"
                                data-bs-parent="#toggle"
                              >
                                <div class="rte accordion-body pb-0 pt-3">
                                  <div class="accordion__content pb-3">
                                    {{ product.description }}
                                  </div>
                                </div>
                              </div>
                            </div>
                          {%- elsif block.settings.description_type == 'default' -%}
                            <div
                              class="rte product__description top-bottom-spacing"
                              {{ block.shopify_attributes }}
                              style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                            >
                              {{ product.description }}
                            </div>
                          {%- endif -%}
                        {%- endif -%}

                      {%- when 'sku' -%}
                        {% if selected_variant.sku and selected_variant.sku != blank %}
                          <div
                            class="sku-code top-bottom-spacing"
                            id="sku-{{ section.id }}"
                            role="status"
                            aria-atomic="true"
                            {{ block.shopify_attributes }}
                            style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                          >
                            <div class="form-label w-100 h6">{{ 'products.product.sku' | t }}</div>
                            {{- selected_variant.sku -}}
                          </div>
                        {% endif %}

                      {%- when 'custom_liquid' -%}
                        <div
                          class="mt-2 top-bottom-spacing"
                          {{ block.shopify_attributes }}
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          {{- block.settings.custom_liquid -}}
                        </div>

                      {% when 'checkout_buttons' %}
                        <span class="text-dangers qty-status invisible"></span>
                        {%- liquid
                          assign activate_gift_card = false
                          if block.settings.show_gift_card_recipient and product.gift_card?
                            assign activate_gift_card = true
                          endif
                          assign accelerated_checkout = false
                          if block.settings.show_dynamic_checkout and activate_gift_card == false
                            assign accelerated_checkout = true
                          endif
                        %}

                        {% if activate_gift_card %}
                          <gift-card-recipient-form
                            data-root-url="{{ product.url }}"
                            data-variant-id="{{ product.first_available_variant.id }}"
                            data-section-id="gift-card-recipient-form"
                            data-gift-card="true"
                          >
                            <div class="fetch-gift-form receipient__form d-flex align-items-baseline gap-2 collapsed ">
                              <p class="m-0">{{ 'recipient.form.checkbox' | t }}</p>
                            </div>
                          </gift-card-recipient-form>
                        {% endif %}
                        <div
                          class="qv-cta_buttons top-bottom-spacing"
                          {{ block.shopify_attributes }}
                          style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          <div id="error-message" class="mt-3"></div>
                          <div class="cta-buttons  single-btn d-flex flex-column w-100 gap-2 gap align-items-start">
                            <div class="d-flex flex-wrap w-100 align-items-center gap-sm-4 gap-3">
                              <quantity-editor {{ block.shopify_attributes }}>
                                <div class=" qv-quantity">
                                  {% comment %}
                                    <label class="form-label w-100 text-capitalize h6 mb-0" for="quantity-{{ section.id }}">
                                      {{- 'products.product.quantity.label' | t -}}
                                    </label>
                                  {% endcomment %}
                                  <div class="quantity mb-0{% if section.settings.nav_style == 'modern' %} bg-transparent{% endif %}">
                                    <button class="decrement-btn quantity__button" aria-label="decrement">
                                      {% render 'icon-toggle-minus' %}
                                    </button>
                                    <input
                                      type="number"
                                      name="quantity"
                                      class="form-control quantity-input"
                                      value="1"
                                      min="1"
                                      {% if selected_variant.inventory_management != blank %}
                                        max="{{ selected_variant.inventory_quantity }}"
                                        data-max="{{ selected_variant.inventory_quantity }}"
                                      {% endif %}
                                      id="quantity-{{ section.id }}"
                                    >
                                    <button class="increment-btn s quantity__button" aria-label="increment">
                                      {% render 'icon-toggle-plus' %}
                                    </button>
                                  </div>
                                </div>
                              </quantity-editor>

                              <button
                                type="submit"
                                name="add"
                                class="btn btn btn-primary text-capitalize main-product-add-cart flex-grow-1"
                                id="addToCart"
                                {% if selected_variant.available == false %}
                                  disabled
                                {% endif %}
                              >
                                {% if selected_variant.available == false %}
                                  {{ 'products.product.sold_out' | t }}
                                {% else %}
                                  {{ 'products.product.add_to_cart' | t }}
                                {% endif %}
                              </button>
                              <div>
                                <div class="product-icons product-icons--main">
                                  <ul class="product-icons_wrapper list-unstyled d-flex gap-3">
                                    <!-- Wishlist -->
                                    <li>
                                      {%- render 'product-wishlist', product: product -%}
                                    </li>
                                    <!-- Compare -->
                                    <li>
                                      {% render 'product-compare', product: product %}
                                    </li>
                                  </ul>
                                </div>
                              </div>
                            </div>
                          
                            {%- if accelerated_checkout -%}
                              {{ form | payment_button }}
                            {%- endif -%}
                          </div>
                        </div>

                      {%- when 'modal_text' -%}
                        <div class="block-popup d-flex top-bottom-spacing" {{ block.shopify_attributes }}
                        style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                      >
                        <p
                          id="ProductPopup-{{ block.id }}"
                          class="m-0 d-inline-flex align-items-center justify-content-between text-start gap-2 modal_text"
                          data-bs-target="#ModalPopup-{{ block.id }}"
                          data-bs-toggle="modal"
                        >
                          {{ block.settings.text | default: block.settings.page.title }}
                          {% render 'icon-info-circle' %}
                        </p>
                      </div>



                      {%- when 'accordion_panel' -%} 
                        <div class="accordion-item accordion--{{ block.id }}" {{ block.shopify_attributes }}
                          style="margin-top:{{ block.settings.padding-block-start }}px; margin-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                          <h2 class="accordion-header" id="heading-{{ block.id }}-{{ section.id }}">
                            <button
                              class="accordion-button collapsed px-0 gap-2"
                              type="button"
                              data-bs-toggle="collapse"
                              data-bs-target="#collapse-{{ block.id }}-{{ section.id }}"
                              aria-controls="collapse-{{ block.id }}-{{ section.id }}"
                            >
                              <span class="{{ block.settings.type_preset }} mb-0">
                                {{ block.settings.heading | default: block.settings.page.title | escape }}
                              </span>
                            </button>
                          </h2>
                          <div
                            class="accordion-collapse collapse"
                            id="collapse-{{ block.id }}-{{ section.id }}"
                            data-bs-parent="#toggle"
                            aria-labelledby="heading-{{ block.id }}-{{ section.id }}"
                          >
                            <div class="rte accordion-body px-0 pb-0 pt-3">
                              <div class="accordion__content rte pb-3">
                                {{ block.settings.content }}
                                {{ block.settings.page.content }}
                              </div>
                            </div>
                          </div>
                        </div>



                      {%- when 'icon_with_text' -%}
                        <div class="icon_with_text top-bottom-spacing"
                        style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                      >
                      {%- render 'icon-with-text',
                        icons_1: block.settings.icons_1,
                        image_1: block.settings.icon1,
                        title1: block.settings.title1,
                        text_alignment1: block.settings.text_alignment1,
                        icons_2: block.settings.icons_2,
                        image_2: block.settings.icon2,
                        title2: block.settings.title2,
                        text_alignment2: block.settings.text_alignment2,
                        icons_3: block.settings.icons_3,
                        image_3: block.settings.icon3,
                        title3: block.settings.title3,
                        text_alignment3: block.settings.text_alignment3,
                        icons_4: block.settings.icons_4,
                        image_4: block.settings.icon4,
                        title4: block.settings.title4,
                        text_alignment4: block.settings.text_alignment4,
                        icons_5: block.settings.icons_5,
                        image_5: block.settings.icon5,
                        title5: block.settings.title5,
                        text_alignment5: block.settings.text_alignment5,
                        block_attributes: block.shopify_attributes
                      -%}
                      </div>


                      {%- when 'size-popup' -%}
                        {% render 'size-popup', section: section, block: block %}

                      {%- when 'rating' -%}
                        <div class="rating_group top-bottom-spacing" {{ block.shopify_attributes }}
                      style="padding-top:{{ block.settings.padding-block-start }}px; padding-bottom:{{ block.settings.padding-block-end }}px;"
                      >
                      {%
                        render 'rating', stars_style: block.settings.stars_style, type_preset: block.settings.type_preset, product: product,
                        rating_color: block.settings.rating_color | color_to_rgb,
                        shopify_attribute: block.shopify_attributes
                      %}
                    </div>

                      {%- when 'deal' -%}
                        {% if product.metafields.dtx['deal_time'].value != blank %}
                        {% assign endTime = product.metafields.dtx['deal_time'].value | date: '%d %b %Y' %}
                        <div class="deal_count top-bottom-spacing"
                           style="--padding-top:{{ block.settings.padding-block-start }}px; --padding-bottom:{{ block.settings.padding-block-end }}px;"
                        >
                        <div class="product-deal-count border border-light" data-end-time="{{endTime}}">
                          
                            {% unless block.settings.heading == blank %}
                              <div class="deal-lable product-label">{{ block.settings.heading }}: </div>
                            {% endunless %}
                         
                          <div class="deal-clock" {{ block.shopify_attributes }}>
                            <ul class=>
                              <li class="days"></li>
                              <li class="hours"></li>
                              <li class="minutes"></li>
                              <li class="seconds"></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      {% endif %}

                      {%- when 'share' -%}
                        {% render 'share',
                          share_title: block.settings.share_label,
                          shopify_attribute: block.shopify_attributes
                        %}
                        {% assign share_title = block.settings.share_label %}
                    {% endcase %}
                  {% endfor %}
                {%- endform -%}
              </main-product-form>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    {%- liquid
      assign popups = section.blocks | where: 'type', 'modal_text'
      render 'popup-loop', popups: popups
      assign canvas_block = section.blocks | where: 'type', 'canvas_panel'
      assign description_block = section.blocks | where: 'type', 'description'
      assign combined_blocks = canvas_block | concat: description_block
      render 'canvas-loop', combined_blocks: combined_blocks
      assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
      for block in section.blocks
        case block.type
          when 'share'
            render 'share-modal', share_link: share_url, share_title: share_title
        endcase
      endfor
    -%}
    <script src="{{- 'photoswipe-lightbox.umd.min.js' | asset_url -}}" defer="defer"></script>
    <script src="{{- 'photoswipe.umd.min.js' | asset_url -}}" defer="defer"></script>
    <script type="module">
        const lightbox = new PhotoSwipeLightbox({
           gallery: '.product__media-list',
          children: 'a',
          pswpModule: PhotoSwipe
        });
      lightbox.init();
       window.product = {{ product | json }};
    </script>

    {% if section.settings.gallery_options == 'inner_zoom' %}
      <script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
    {% endif %}

 
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </section>
</product-template>

{% schema %}
{
  "name": "t:name.featured_product",
  "class": "featured-product main-product-template",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "checkbox",
      "id": "show_sticky",
      "label": "t:settings.show_sticky",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "media_width",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "medium",
      "label": "t:settings.media_width"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "media_border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.media_border != 'none' }}"
    },
    {
      "type": "range",
      "id": "media_border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.media_border != 'none' }}"
    },
    {
      "type": "range",
      "id": "media_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "unit": "px",
      "step": 1,
      "default": 0
    },
    {
      "type": "select",
      "id": "slider_option",
      "options": [
        {
          "value": "horizontal",
          "label": "t:options.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:options.vertical"
        },
        {
          "value": "stacked",
          "label": "t:options.stacked"
        }
      ],
      "default": "horizontal",
      "label": "t:settings.slider_option"
    },
    {
      "type": "select",
      "id": "gallery_options",
      "label": "t:settings.gallery_options",
      "options": [
        {
          "value": "inner_zoom",
          "label": "t:options.inner_zoom"
        },
        {
          "value": "photoswipe_lightbox",
          "label": "t:options.photoswipe_lightbox"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "none",
      "info": "High resolution images will give the better visibility"
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "options": [
        {
          "value": "show",
          "label": "t:options.show"
        },
        {
          "value": "hide",
          "label": "t:options.hide"
        }
      ],
      "default": "hide",
      "label": "t:settings.mobile_thumbnails",
      "visible_if": "{{ section.settings.slider_option != 'stacked' }}"
    },
    {
      "type": "header",
      "content": "t:content.media_navigation",
      "visible_if": "{{ section.settings.slider_option != 'stacked' }}"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "visible_if": "{{ section.settings.slider_option != 'stacked' }}",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrow"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.slider_option != 'stacked' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' and section.settings.style == 'arrow' and section.settings.slider_option != 'stacked' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none'  and section.settings.style == 'arrow' and section.settings.slider_option != 'stacked' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.slider_option != 'stacked' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.slider_option != 'stacked'  }}"
    },
    {
      "type": "color_scheme",
      "id": "pagination_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.inherit_color_scheme == false and section.settings.style == 'arrow' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "vendor",
      "name": "t:name.vendor",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:settings.top",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:settings.bottom",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 10
        }
      ]
    },
    {
      "type": "text",
      "name": "t:name.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Text block</p>",
          "label": "t:settings.text"
        },
        {
          "type": "header",
          "content": "t:content.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:settings.top",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:settings.bottom",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 10
        }
      ]
    },
    {
      "type": "title",
      "name": "t:name.title",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:settings.top",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:settings.bottom",
          "min": 0,
