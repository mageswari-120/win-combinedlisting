{% comment %}
  {% capture children %}
    {% content_for 'blocks' %}
  {% endcapture %}
{% endcomment %}

{% comment %} {% render 'custom-section', section: section, children: children %} {% endcomment %}

{% liquid
  assign alignment = 'align-items-' | append: section.settings.vertical_alignment
  assign position = 'justify-content-' | append: section.settings.horizontal_alignment
  assign text_alignment = 'text-' | append: section.settings.vertical_alignment
%}

<div
  class="color-{{ section.settings.color_scheme }}  main-404-page-{{section.id }}"
  style="{% if section.settings.background_media == 'image' %}
        background-image: url({{ section.settings.background_image | image_url }});
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
      {% endif %}"
>
  <div
    class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %} spacing-style border-style layout_height custom-background-wrapper"
    style="
        {% render 'spacing-style', settings: section.settings %}
      {% render 'border-style' , settings: section.settings %}
      {% if section.settings.section_height == 'custom' %}
        --section-min-height: {{ section.settings.section_height_custom }}svh;
      {% else %}
        --section-min-height: var(--section-height-{{ section.settings.section_height }});
      {% endif %}
      {% if section.settings.section_height != 'custom' %}
        --section-preview-height: 600px;
      {% endif %}
    "
  >
    <div
      class="main-404-page d-flex flex-column {{ alignment }} justify-content-center {{ text_alignment }}"
      style="position:relative; z-index:2; gap:max(calc(var(--space-scale, 1.0) * {{ section.settings.grid_space }}px));"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:name.404-page",
  "tag": "section",
  "class": "section template-404",
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "button" }, { "type": "image" } ],
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "grid_space",
      "label": "t:settings.gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "enabled_on": { "templates": ["404"] }
}
{% endschema %}
