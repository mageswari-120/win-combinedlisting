{% liquid
  assign show_desktop_slider = false
  assign collection_style = section.settings.layout_type
  if collection_style == 'carousel'
    assign collection_style = true
    assign show_desktop_slider = true
  else
    assign collection_style = false
    assign show_desktop_slider = false
  endif

  if show_desktop_slider
    assign auto_play = 0
    assign centered_mode = false
    assign loop_slide = false
    assign dots = section.settings.swiper_pagination
    assign space = section.settings.horizontal_gap | default: 0
  endif

  assign slider_desktop = section.settings.columns_desktop | default: 3
  assign slider_laptop = section.settings.columns_desktop | minus: 1
  if section.settings.columns_desktop == '5'
    assign slider_tablet = 3
  elsif section.settings.columns_desktop == '6'
    assign slider_laptop = 4
    assign slider_tablet = 3
    assign slider_mobile = 2
  else
    assign slider_tablet = 2
  endif
  assign slider_mobile = section.settings.columns_mobile | default: 1

  assign collection_item = section.settings.collection_list
%}

{% render 'swiper-initialization', space: space, slider_desktop: slider_desktop %}

{% style %}
  .placeholder-image svg, media-gallery img{width:100%; height:100%;}
  colletion-list{overflow:hidden;}
  .collection-grid {list-style: none; padding-left:0;}
  .card__inner_wrapper + .shopify-block{height:100%;}
   .collection-grid.collection-grid--{{ section.id }}{
    grid-template-columns:var(--grid-mobile-columns);
  }
  @media screen and (width >= 576px){
   .collection-grid.collection-grid--{{ section.id }}{
    grid-template-columns:var(--grid-tablet-column);
  }
  }
  @media screen and (width >= 992px){
   .collection-grid.collection-grid--{{ section.id }}{
    grid-template-columns:var(--grid-laptop-columns);
  }
  }
  @media screen and (width >= 1200px){
   .collection-grid.collection-grid--{{ section.id }}{
    grid-template-columns:var(--grid-desktop-columns);
  }
  }
    /* .section-{{ section.id }} .collection-card :is(.collection-details){ z-index: 4; }
    .section-{{ section.id }} .collection-card .collection-link{ z-index: 5; } */
{% endstyle %}

{% capture swiper_controls %}
    {%- render 'swiper-controls',
      show_desktop_slider: show_desktop_slider,
      section: section,
      settings:section.settings
    -%}
  {% endcapture %}

<div class="section-{{ section.id }} color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}">
  <div
    class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %} d-grid top-bottom-spacing position-relative"
    style="
      --padding-top:{{ section.settings.padding-top }}px;
      --padding-bottom:{{ section.settings.padding-bottom }}px;
    "
    {% if settings.animation != blank %}
      data-aos="{{ settings.animation}}"
    {% endif %}
  >
    {% content_for 'blocks' %}

    {% if show_desktop_slider %}
      <colletion-list>
        <div
          data-slider-options='
            {
                "desktop": "{{ slider_desktop }}",
                "laptop": "{{ slider_laptop }}",
                "tablet": "{{ slider_tablet }}",
                "mobile": "{{ slider_mobile }}",
                "loop": "{{ loop_slide }}",
                "mode": "{{ centered_mode }}",
                "auto_play": "{{ auto_play }}",
                "dots": "{{ dots }}",
                "space": "{{ space }}"
            }
          '
        >
          <div class="collection-carousel position-relative swiper" data-swiper-slider>
            <div class="collection-carousel-wrapper swiper-wrapper">
              {% for collection in collection_item %}
                <div class="swiper-slide h-auto">
                  {% content_for 'block',
                    type: 'collection-card',
                    id: 'collection-card',
                    collection: collection,
                    closest.collection: collection
                  %}
                </div>
              {% else %}
                {% for i in (1..section.settings.columns_desktop) %}
                  <div class="swiper-slide h-auto">
                    {% content_for 'block',
                      type: 'collection-card',
                      id: 'collection-card',
                      collection: collection,
                      closest.collection: collection
                    %}
                  </div>
                {% endfor %}
              {% endfor %}
            </div>
            {{ swiper_controls }}
          </div>
        </div>
      </colletion-list>
    {% else %}
      <ul
        class="collection-grid collection-grid--{{ section.id }}"
        style="
          display:grid; --grid-desktop-columns: repeat({{ slider_desktop }}, 1fr); --grid-laptop-columns: repeat({{ slider_laptop }},1fr); --grid-tablet-column: repeat({{ slider_tablet }},1fr);
          --grid-mobile-columns: repeat({{ section.settings.columns_mobile}}, 1fr); row-gap:max(calc(var(--space-scale, 1.0) * {{ section.settings.vertical_gap }}px));
          column-gap: max(calc(var(--space-scale, 1.0) * {{ section.settings.horizontal_gap }}px));
        "
      >
        {% for collection in collection_item %}
          <li>
            {% content_for 'block',
              type: 'collection-card',
              id: 'collection-card',
              collection: collection,
              closest.collection: collection
            %}
          </li>
        {% else %}
          {% for i in (1..section.settings.columns_desktop) %}
            <li>
              {% content_for 'block',
                type: 'collection-card',
                id: 'collection-card',
                collection: collection,
                closest.collection: collection
              %}
            </li>
          {% endfor %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:name.collection-list",
  "class": "collection-list",
  "max_blocks": 1,
  "blocks": [{ "type": "header-block" }],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list",
      "limit": 10
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'editorial' }}"
    },
    {
      "type": "header",
      "content": "t:content.column"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "options": [
        {
          "value": "3",
          "label": "t:options.column_3"
        },
        {
          "value": "4",
          "label": "t:options.column_4"
        },
        {
          "value": "5",
          "label": "t:options.column_5"
        },
        {
          "value": "6",
          "label": "t:options.column_6"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.column_1"
        },
        {
          "value": "2",
          "label": "t:options.column_2"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "visible_if": "{{ section.settings.layout_type == 'carousel' }}",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrow"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
         {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' and section.settings.style == 'arrow' and section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.style == 'arrow'  and section.settings.border != 'none' and section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none'  and section.settings.style == 'arrow' and section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.layout_type == 'carousel'  }}"
    },
    {
      "type": "color_scheme",
      "id": "pagination_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:content.custom_class"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:settings.custom_class"
    }
  ],
  "presets": [
    {
      "name": "t:name.collection-list",
      "category": "t:categories.collections",
      "settings": {},
      "blocks": {
        "group_01": {
          "type": "header-block",
          "name": "t:name.header-block",
          "settings": {},
          "blocks": {
            "text": {
              "type": "text",
              "name": "t:settings.description",
              "settings": {
                "text": "<p>description</p>"
              },
            },
            "heading": {
              "type": "text",
              "name": "t:name.heading",
              "settings": {
                "text": "<h2>Headling</h2>"
              },
            }
          },
          "block_order": ["heading","text"]
        },
        "collection-card": {
          "type": "collection-card",
          "name": "t:names.collection_card",
          "static": true,
          "settings": {},
          "blocks": {
            "collection-image": {
              "type": "collection-image",
              "name": "Collection image",
              "static": true,
              "settings": {}
            },
          }  
        }
      },
      "block_order": ["group_01"]
    }
  ]
}
{% endschema %}
