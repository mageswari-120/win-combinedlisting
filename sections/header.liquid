{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor


    assign enable_flag = section.settings.flag
-%}

{% capture primaryMenu %}
    {%- if section.settings.menu != blank -%}     
      <nav class="d-none d-lg-block {%- if section.settings.menu_position == 'bottom' -%}pb-1 pb-sm-3{%- endif -%} {% if section.settings.menu_allignment != 'center' and section.settings.menu_position == 'bottom' %} container-fluid {% elsif  section.settings.menu_allignment != 'center'%} px-0{% endif %}">
       <ul class="dt-sc-list-inline dt-desktop-menu dt-nav d-inline-flex flex-wrap navbar-nav d-none d-lg-flex" data-menu="dt-main-menu">     
        {%- for link in linklists[section.settings.menu].links -%}  
        {% render 'navigation',
           class: 'primaryMenu',
           link: link,
           section: section,
           menu_position:section.settings.menu_position,
           font_style:section.settings.type_preset
           %}
        {%- endfor -%}
      </ul>
        </nav>
    {%- endif -%}
  {%  endcapture %}


{% capture logo %}
  {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
  {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
  {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
  {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
  {{ settings.logo | image_url: width: 600 | image_tag: class: '', widths: widths, height: logo_height, width: settings.logo_width, alt: logo_alt, sizes: sizes, preload: true }}
{% endcapture %}

{% capture transparent_logo %}
  {%- assign logo_alt = section.settings.transparent_logo.alt | default: shop.name | escape -%}
  {%- assign logo_height = section.settings.transparent_width | divided_by: section.settings.transparent_logo.aspect_ratio | round -%}
  {% capture sizes %}(max-width: {{ section.settings.transparent_width | times: 2 }}px) 50vw, {{ section.settings.transparent_width }}px{% endcapture %}
  {% capture widths %}{{ section.settings.transparent_width }}, {{ section.settings.transparent_width | times: 1.5 | round }}, {{ section.settings.transparent_width | times: 2 }}{% endcapture %}
  {{ section.settings.transparent_logo | image_url: width: 600 | image_tag: class: '', widths: widths, height: logo_height, width: section.settings.transparent_width, alt: logo_alt, sizes: sizes, preload: true }}
{% endcapture %}
  
<{% if section.settings.sticky_header_type == 'sticky' %}sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %} class="navbar {% if section.settings.transparent_header == true and request.page_type  == 'index'  %} color-{{ section.settings.transparent_color_scheme }} {% else %} color-{{ section.settings.color_scheme }} gradient {% endif %} {% if section.settings.border_bottom and request.page_type != 'index' %}border-bottom border-1{% endif %} header-wrapper ">
  {%- liquid
