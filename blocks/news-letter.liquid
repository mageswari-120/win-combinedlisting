{% liquid
  assign horizontal_alignment = 'align-items-sm-' | append: block.settings.horizontal_alignment
  assign text_alignment = 'text-sm-' | append: block.settings.horizontal_alignment
  assign horizontal_alignment_mobile = 'align-items-' | append: block.settings.horizontal_alignment_mobile
  assign text_alignment_mobile = 'text-' | append: block.settings.horizontal_alignment_mobile
%}

{% style %}
  @media (max-width: 400px) {
    .news-letter-block .email_input_group  { display: flex !important; flex-direction: column; align-items: {{ block.settings.horizontal_alignment_mobile }}; gap: 15px; }
  }
{% endstyle %}

<div
  class="news-letter overflow-hidden position-relative{% if block.settings.inherit_color_scheme != true %} color-{{ block.settings.color_scheme }} {% endif %}"
  style="{% render 'text-bg-space', settings: block.settings  %}"
  {{ block.shopify_attributes }}
>
  <div
    class="position-relative news-letter-block w-100 h-100 d-flex flex-column spacing-style gap-style {{ horizontal_alignment_mobile }} {{ horizontal_alignment }} {{ text_alignment }} {{ text_alignment_mobile }}"
    style="
    --gap-style: max(calc(var(--space-scale, 1.0) * {{ block.settings.grid_space }}px)); {% render 'spacing-style', settings:block.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:name.newsletter",
  "tag": null,
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "newsletter" }, { "type": "footer-social-icon" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "primary",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "t:settings.mobile_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.newsletter",
      "category": "t:categories.layout",
      "settings": {
        "grid_space": 16
      },
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<h4>News letter </h4>"
          }
        },
        {
          "type": "description",
          "settings": {
            "text": "description"
          }
        },
        {
          "type": "newsletter"
        },
        {
          "type": "footer-social-icon",
          "blocks": [
            {
              "type": "_social-link"
            },
            {
              "type": "_social-link"
            },
            {
              "type": "_social-link"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
