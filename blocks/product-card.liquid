{% liquid
  assign product = closest.product
-%}

{%- capture alignment -%}
{%- case block.settings.alignment -%}
{%- when 'center' -%}
text-center justify-content-center
{%- when 'end' -%}
text-end justify-content-end
{%- endcase -%}
{%- endcapture -%}

<div
  class="resource-card {% if block.settings.inherit_color_scheme == true %} color-{{ block.settings.color_scheme }} {% endif %} border-style d-flex flex-column h-100 w-100"
  {{ block.shopify_attributes }}
  style="{% render 'border-style', settings: block.settings %}"
>
  <div class="card_media" {{ block.shopify_attributes }}>
    {% content_for 'block', id: 'featured-media', type: 'featured-media', image: article.image %}
  </div>

  <div
    class="card_body {{ alignment }} {{ mobile_alignment }} spacing-style"
    style="{% render 'spacing-style', settings: block.settings  %}"
  >
    {% content_for 'block',
      id: 'product-title',
      type: 'product-title',
      closest.product: product,
      alignment: alignment
    %}
    {% content_for 'block', id: 'rating', type: 'rating', closest.product: product, alignment: alignment %}
    {% content_for 'block', id: 'price', type: 'price', closest.product: product, alignment: alignment %}
    {% content_for 'block', id: 'card-swatch', type: 'card-swatch', closest.product: product, alignment: alignment %}
    {% comment %} {% content_for 'block', id: 'cart_button', type: 'cart_button', closest.product: product, alignment:alignment %} {% endcomment %}



    {% comment %}  only list view start {% endcomment %}

  
    {% if product.metafields.custom.product_description %}
      <div class="product_description mt-3">
        {{ product.metafields.custom.product_description }}
      </div>
    {% endif %}

    <div class="product_card_icons mt-3 d-flex flex-wrap justify-content-center align-items-center gap-2 w-100">
      {% if settings.enable_quickview %}
        <div class="quick_view">
          {% render 'quick-select-button', card_product: product %}
        </div>
      {% endif %}
      {% if settings.enable_wishlist %}
        {% render 'button-wishlist' %}
      {% endif %}
      {% if settings.enable_compare %}
        {% render 'button-compare' %}
      {% endif %}
    </div>

    {% comment %}  only list view start {% endcomment %}


  </div>
</div>

{% schema %}
{
  "name": "t:name.product_card",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.product_card_title"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3",
      "visible_if": "{{ block.settings.inherit_color_scheme == true }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "unit": "px",
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:name.product_card",
      "category": "t:categories.product",
      "settings": {}
    }
  ]
}
{% endschema %}
