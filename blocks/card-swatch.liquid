
<div
  class="position-relative  card-swatch-block top-bottom-spacing"
  style="--padding-top:{{ block.settings.padding-block-start }}px; --padding-bottom:{{ block.settings.padding-block-end }}px;"
  {{ block.shopify_attributes }}
>
  {% if closest.product.media.size > 0 %}
    {% render 'card-swatch', product: closest.product, settings: block.settings, alignment:alignment %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:name.swatch",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.product_swatches"
    },
    {
      "type": "select",
      "id": "swatches",
      "label": "t:settings.swatches",
      "options": [
        {
          "value": "color",
          "label": "t:options.color"
        },
        {
          "value": "image",
          "label": "t:options.image"
        }
      ],
      "default":"color"
    },
    {
        "type": "range",
        "id": "variant_swatch_width",
        "min": 16,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "t:settings.width",
        "default": 30
      },
      {
        "type": "range",
        "id": "variant_swatch_height",
        "min": 16,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "t:settings.height",
        "default": 30
      },
      {
        "type": "range",
        "id": "variant_swatch_radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:settings.border_radius",
        "default": 100
      },
      {
        "type": "range",
        "id": "variant_swatch_border_width",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "unit": "px",
        "label": "t:settings.thickness",
        "default": 1
      },
      {
        "type": "range",
        "id": "variant_swatch_border_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "t:settings.opacity",
        "default": 10
      },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:name.swatch",
      "category": "t:categories.product",
      "settings": {
      }
    }
  ]
}
{% endschema %}
