{% liquid
  assign direction = "flex-" | append: block.settings.direction
  assign alignment = "align-items-" | append: block.settings.alignment
  assign position = "justify-content-" | append: block.settings.alignment
  assign text_align = "text-" | append: block.settings.alignment
%}

<div class="author__details spacing-style w-100 author__details-{{ block.id }} d-flex {{ text_align }} {{ direction }} {% if block.settings.direction == 'column' %} {{ alignment }} justify-content-start {% endif %} {% if block.settings.direction == 'row' %} {{ position }} align-items-center {% endif %} "
style="gap: {{ block.settings.gap }}px; {% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="author_profile">
        {% if block.settings.author_profile != blank %}
            {{
              block.settings.author_profile
              | image_url: width: 3000
              | image_tag:
                width: block.settings.author_profile.width,
                class: 'object-fit-cover image-block ',
                widths: widths,
                sizes: sizes
            }}
          {% else %}
            <div class="placeholder-image ">
              {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg object-fit-contain' }}
            </div>
          {% endif %}
    </div>
    <div class="author-name">
        <h6 class="mb-0">{{ block.settings.author_name }}</h6>
        <span class="mb-0">{{ block.settings.verified }}</span>
    </div>
</div>

{% style %}
.author__details-{{ block.id }} .author_profile .image-block, .author__details-{{ block.id }} .author_profile .placeholder-image { width: 80px; height: 80px; border-radius: {{ block.settings.radius }}px; }
.author__details-{{ block.id }} .author-name h6 p, .author__details-{{ block.id }} .author-name span p  { margin: 0px !important; }
 {%endstyle %}

{% schema %}
{
  "name": "t:name.author_details",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "author_profile",
      "label": "t:settings.author_image"
    },
    {
      "type": "richtext",
      "id": "author_name",
      "label": "t:settings.author_name"
    },
    {
      "type": "inline_richtext",
      "id": "verified",
      "label": "t:settings.verified"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "row", "label": "t:options.vertical" },
        { "value": "column", "label": "t:options.horizontal" }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.author_details"
    }
  ]
}
{% endschema %}
