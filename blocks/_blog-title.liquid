<div class="title-block {{ block.settings.type_preset }} text-{{ block.settings.text_transform }} spacing-style m-0" {{ block.shopify_attributes }} style="{% render 'spacing-style', settings:block.settings %}">
 <a href="{{ article.url }}">{{ article.title | default: 'Blog post'  }}</a>
</div>
{% schema %}
{
  "name": "t:name.heading",  
  "tag": null,
  "settings": [   
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:content.typography",
      "options": [
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
      ],
      "default": "h5",
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "t:settings.testcase",
      "options": [
        {
          "value": "rte",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        },
        {
          "value": "capitalize",
          "label": "t:options.capitalize"
        },
        {
          "value": "lowercase",
          "label": "t:options.lowercase"
        }
      ],
      "default": "capitalize"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
  ] 
}
{% endschema %}