{% style %}
     .footer-image-block-{{ block.id }} .footer-block-image {
      width:{{ block.settings.width }}px !important;
    }
  .footer-image-block-{{ block.id }} .footer-block-image{height:auto;}

  .footer-image-block-{{ block.id }} img {
    /* aspect-ratio: 1; */
    object-fit:cover;
  }

    .footer-image-block-{{ block.id }} .placeholder-image{ width:{{ block.settings.width }}px !important; aspect-ratio: 3 / 2; }
    .footer-image-block-{{ block.id }} .placeholder-image svg{
      background: rgba(var(--color-foreground),.1);
      width: 100%;
      height: 100%;
     }
{% endstyle %}

<div class="footer-image-block-{{ block.id }}">
  {% assign icon = 'footer-block-image footer-block-image-' | append: block.id %}
  {% capture icon %}
 
  {% if block.settings.image_upload != blank %}
  {% liquid
      assign media_width_desktop = '100vw'
      assign media_width_mobile = '100vw'
      assign sizes = '(min-width: 1024px) 1024px, ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
      assign widths = '300, 375, 450, 525, 600, 675, 750, 768, 850, 900, 1024'
    %}
{% assign image_style = 'width: ' | append: block.settings.width | append: 'px;' %}
 {{
      block.settings.image_upload
      | image_url: width: 1024
      | image_tag:
        widths: widths,
        class: icon,
        style: image_style,
        sizes: sizes
    }}
  {% else %}
    <div class="placeholder-image">
      {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg' }}
    </div>
  {% endif %}
{% endcapture %}

  <div
    class="footer-logo-container d-inline-block overflow-hidden spacing-style border-style"
    style="{% render 'spacing-style', settings:block.settings %}"
  >
    <a
      href="{{ block.settings.link }}"
      class="footer-logo-image"
      {% if block.settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      {{ icon }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "t:name.footer-logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_upload",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:settings.width",
      "min": 50,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.footer-logo",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
