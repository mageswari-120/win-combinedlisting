{% liquid
  assign alignment = 'align-items-' | append: block.settings.alignment
  assign position = 'align-items-' | append: block.settings.position
  assign text_alignment = 'text-' | append: block.settings.alignment
%}

<div
  class="details  w-100 border-style details-{{block.id }}"
  style="{% render 'border-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <div
    class="details__  h-100 d-flex {{ position }} "
    style="
      {% if block.settings.background_image != blank %}
        background-image: url({{ block.settings.background_image | image_url }});
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        height: 100%;
      {% endif %}
       {%if block.settings.background_image == blank %}
      
      {%endif %}
    "
  >
    <div
      class="details-block  spacing-style d-flex flex-column  {% if block.settings.inherit_color_scheme == false %}color-{{block.settings.color_scheme}}{% endif %} w-100 {{alignment}} {{ text_alignment }}"
      style="gap: max(calc(var(--space-scale, 1.0) * {{ block.settings.grid_space }}px));
      {% render 'spacing-style', settings: block.settings %}
       "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
 

{% schema %}
{
  "name": "t:name.details",
  "tag": null,
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "button" }, { "type": "image" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:settings.position",
      "options": [
        { "value": "start", "label": "t:options.top" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 15
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.details",
      "blocks": [
        { "type": "image" },
        { "type": "text", "settings": { "text": "<h2>Title</h2>" } },
        {
          "type": "description",
          "settings": {
            "text": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review."
          }
        },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
