

{% style %}


  :root{
    --email-btn-width: 0px;
  }

    .email_wrapper-{{ block.id }} .email_input_group {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    max-height:200px;
    }
    .email_wrapper-{{ block.id }}.email_wrapper{ width: 100%; }
    .email_wrapper-{{ block.id }} .email__input {
    width: 100%;
    }
    {% if block.settings.border_input_style == 'all' %}
    .email_wrapper-{{ block.id }} .email__input {
    border:var(--bs-input-border-width) solid rgb(var(--color-border));
    border-radius: var(--bs-input-border-radius) !important;
    outline: none !important;
    }
    {% if block.settings.combined_button == true %}
    .email_wrapper-{{ block.id }} .email__button {
    margin:calc(var(--bs-input-border-width) + 4px);
    }
    /* .email_wrapper-{{ block.id }} .email__input:focus {
    box-shadow: 2px 2px 4px;
    } */
    {% endif %}
    {% endif %}

    {% if block.settings.border_input_style == 'none' %}
    .email_wrapper-{{ block.id }} .email__input {
    border: 0px !important;
    border-radius: var(--bs-input-border-radius) !important;
    outline: none !important;
    }
    {% if block.settings.combined_button == true %}
    .email_wrapper-{{ block.id }} .email__button {
    margin:4px;
    }
    {% endif %}
    {% endif %}



    /* styled for underline */
    {% if block.settings.border_input_style == "underline" and block.settings.combined_button == false %}
    .email_wrapper-{{ block.id }} .email__input {
      background:transparent;
      border:0; 
      border-radius:0;
      {% if settings.input_border_thickness != 0 %} 
        border-bottom: var(--bs-input-border-width) solid rgb(var(--color-border));
      {% else %} 
        /* border-bottom: 1px solid rgb(var(--color-border)) */
        padding-bottom: 5px;
      {% endif %}
      } 
      .email_wrapper-{{ block.id }} .email_input_group .email__input:focus{
      box-shadow: 0 2px 0 0 rgb(var(--color-input-text));
    }  
    .email_wrapper-{{ block.id }} .email__input:focus-visible {outline:none;}
    {% endif %}

    {% if block.settings.border_input_style == "underline" and block.settings.combined_button == true %}
    .email_wrapper-{{ block.id }} .email_input_group {
      background:transparent; 
      border:0; 
      {% if settings.input_border_thickness != 0 %} 
        /* border-bottom: var(--bs-input-border-width) solid rgb(var(--color-border));  */
        padding-bottom: 5px;
      {% else %} 
        /* border-bottom: 1px solid rgb(var(--color-border)) */
      {% endif %}
      } 
      .email_wrapper-{{ block.id }} .email_input_group:after {
        content: '';
        position: absolute;
        width: 100%;
        height: var(--bs-input-border-width);
        background: rgb(var(--color-border));
        bottom: 0px;
    }
    .email_wrapper-{{ block.id }} .email_input_group:has(.email__input:focus):after { height: 2px; }
    .email_wrapper-{{ block.id }} .email_input_group .email__input:focus{
      box-shadow: unset;
    }  
    .email_wrapper-{{ block.id }} .email__input {background:transparent; border: none; border-radius:0;};
    .email_wrapper-{{ block.id }} .email_input_group:focus-visible {outline:none;}
    {% endif %}

    /* styled for submit btn border */
    .email_wrapper-{{ block.id }} .email__button{
    border-radius:{{block.settings.border_submit_radius}}px;
    }
    {% if  block.settings.submit_btn_style != 'btn-link' and block.settings.border_submit_style == true   %}
    .email_wrapper-{{ block.id }} .email__button{
    border-width:{{block.settings.border_submit_width}}px;
    }

    {% endif %}


    @media screen and (min-width:768px){
    .position-md-absolute{position:absolute;}
      {% if block.settings.combined_button == true %}
        .email_wrapper-{{ block.id }} .email__input {
        padding-inline-end: calc(var(--email-btn-width) + 20px) !important;
        }
      {% endif %}
    }
    @media (max-width: 576px) {
    .email_wrapper-{{ block.id }} .email__button {
    padding:12px;
    }
    }


{% endstyle %}








<div
  class="email_wrapper email_wrapper-{{ block.id }} spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- form 'customer' %}
    <div class="email_input_group email_input_group-{{block.id }} align-content-center {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}">
      <label for="EmailInput-{{ block.id }}" class="visually-hidden">
        {{ 'newsletter.label' | t }}
      </label>
      <input
        id="EmailInput-{{ block.id }}"
        class="form-control email__input email__input-{{block.id }} email__input--{{ block.settings.border_input_style }} {{ block.settings.input_typography }} {{ block.settings.border_variation }} mb-0 px-3 py-3"
        type="email"
        name="contact[email]"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder=" {{ 'newsletter.label' | t }} "
        required
        {% if form.errors %}
          autofocus
          aria-invalid="true"
          aria-describedby="Email-signup__message-error-{{ block.id }}"
        {% elsif form.posted_successfully? %}
          aria-describedby="Email-signup__message-success-{{ block.id }}"
        {% endif %}
      >
      <button
        class="
           email__button d-flex justify-content-center align-items-center {% if block.settings.display_type == 'arrow' %} p-0 {%endif %} btn text-wrap
          {% if block.settings.combined_button and  block.settings.border_input_style != "underline" %} position-md-absolute top-0 bottom-0 end-0 {% else %} ms-2 {% endif %}
           {% if block.settings.submit_btn_style == 'btn-link' %} px-3 {% endif %}
            email__button--{{ block.settings.display_type }} {{ block.settings.button_typography }}
           {{ block.settings.submit_btn_style }}
        "
        {% if block.settings.display_type != 'text' %}
          aria-label="{{ block.settings.submit_btn_label | default: 'Submit' }}"
        {% endif %}
      >
        {% if block.settings.display_type == 'text' and block.settings.submit_btn_label != none %}
          {{ block.settings.submit_btn_label | default: 'Submit' }}
        {% else %}
          <svg
            viewBox="0 0 20 20"
            width="46"
            height="33"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
            aria-hidden="true"
            class="email__button-icon w-100 h-100"
          >
            {% render 'icon', icon: 'arrow' %}
          </svg>
        {% endif %}
      </button>
    </div>

    {%- if form.errors -%}
      <div
        id="Email-signup__message-error-{{ block.id }}"
        class="email-signup__message email-signup__message--error d-flex justify-content-center align-baseline gap-1 mt-4"
        tabindex="-1"
      >
        {%- render 'icon-error' -%}
        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        id="Email-signup__message-success-{{ block.id }}"
        class="email-signup__message email-signup__message--success d-flex justify-content-center align-baseline gap-1 mt-4"
        tabindex="-1"
      >
        <span class="svg-wrapper icon-success">
          {% render 'icon-success' -%}
        </span>
        <p class="email-signup__message-text mb-0 ">{{ 'newsletter.success' | t }}</p>
      </div>
    {%- endif -%}
  {% endform %}
</div>



{% schema %}
{
  "name": "t:name.email_signup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Input"
    },
    {
      "type": "select",
      "id": "input_typography",
      "label": "t:content.typography",
      "options": [
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "p",
          "label": "t:options.p"
        }
      ],
      "default": "p"
    },
    {
      "type": "select",
      "id": "border_input_style",
      "label": "t:settings.border",
      "options": [
        {
          "value": "all",
          "label": "t:options.solid"
        },
        {
          "value": "underline",
          "label": "t:options.underline"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "all"
    },

    {
      "type": "header",
      "content": "t:content.button"
    },
    {
      "type": "select",
      "id": "submit_btn_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "btn-primary",
          "label": "t:content.primary_button"
        },
        {
          "value": "btn-secondary",
          "label": "t:content.secondary_button"
        },
        {
          "value": "btn-link",
          "label": "t:settings.link"
        }
      ],
      "default": "btn-primary"
    },

    {
      "type": "select",
      "id": "display_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "text",
          "label": "t:settings.text"
        },
        {
          "value": "arrow",
          "label": "t:options.arrow"
        }
      ],
      "default": "text"
    },
    {
      "type": "text",
      "id": "submit_btn_label",
      "label": "t:settings.text",
      "default": "sign up",
      "visible_if": "{{ block.settings.display_type == 'text' }}"
    },
    {
      "type": "checkbox",
      "id": "combined_button",
      "label": "t:settings.combined_button",
      "default": false,
      "info": "t:info.email_combined_button"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.email_signup",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
