{% liquid
  if block.settings.content_direction == 'column'
    assign direction = 'flex-column'
  elsif block.settings.vertical_on_mobile == true
    assign direction = 'flex-column flex-sm-row'
  elsif block.settings.vertical_on_mobile == false
    assign direction = 'flex-row'
  endif
%}

<style>
    .slideshow .slide-{{ block.id }} .banner-overlay{
      padding: calc(var(--bs-gutter-x) * .5);
    }
   
    @media (min-width:768px){
    .slideshow .slide-{{ block.id }} .banner-overlay .content-block{ max-width: var(--content-width); }
    }
  

    @media (max-width:575.98px){
      {% if section.settings.mobile_layout %}
       .slideshow .slide-{{ block.id }} .banner-overlay{ grid-area: unset;  padding:0;min-height: unset; }
       .slideshow .swiper-pagination, .slideshow.section-{{ section.id }} .swiper-navigation{ position:unset !important; }
      {% endif %}
       .slideshow .slide-{{ block.id }} .banner-overlay .content-block{
         justify-content:{{ block.settings.text_alignment_mobile }};
         align-items:{{ block.settings.text_alignment_mobile }};
         text-align: {{ block.settings.text_alignment_mobile }};
       }
        .slideshow.content_with_overlay  .swiper-slide.slide-item {height:100% !important;}
    }
</style>

<div
  class="swiper-slide slide-item d-grid h-auto slide-{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div class="swipper_banner h-100 {% unless section.settings.height == "adapt" %} position-sm-absolute inset-0 {% endunless %} {% if block.settings.image == blank %} placeholder-svg {% endif %}">
    {% comment %}
      {%- liquid
        assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
        assign media_width_desktop = '100vw'
        assign media_width_mobile = '100vw'
        assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
        assign lazy_sizes = 'auto, ' | append: sizes
        assign widths = '832, 1200, 1600, 1920, 2560, 3840'
      %}
    {% endcomment %}

    {% if block.settings.media_type == 'image' %}
      {% if block.settings.image != blank %}
        {% if forloop.first %}
          {{
            block.settings.image
            | image_url: width: 3000
            | image_tag:
              loading: 'eager',
              height: height,
              sizes: lazy_sizes,
              widths: widths,
              class: 'w-100 d-none d-md-block h-100 object-fit-cover'
          }}
        {% else %}
          {{
            block.settings.image
            | image_url: width: 3000
            | image_tag:
              class: 'w-100 d-none d-md-block  h-100 object-fit-cover',
              height: height,
              sizes: lazy_sizes,
              widths: widths,
              loading: 'lazy'
          }}
        {% endif %}
      {% else %}
        {%- assign placeholder_image_index = forloop.index0 | modulo: 2 | plus: 1 -%}
        {%- assign placeholder_image = 'lifestyle-' | append: placeholder_image_index -%}
        {{
          placeholder_image
          | placeholder_svg_tag: 'placeholder-svg bg-light w-100 h-100 d-none d-md-block opacity-50 bg-transparent'
        }}
      {% endif %}
      {% if block.settings.mobile_image != blank %}
        {% if forloop.first %}
          {{
            block.settings.mobile_image
            | image_url: width: 768
            | image_tag:
              class: 'w-100 d-block d-md-none mobile-img-height h-100 object-fit-cover',
              loading: 'eager',
              height: height,
              sizes: lazy_sizes,
              widths: widths
          }}
        {% else %}
          {{
            block.settings.mobile_image
            | image_url: width: 768
            | image_tag:
              class: 'w-100 d-block d-md-none mobile-img-height h-100 object-fit-cover',
              loading: 'lazy',
              height: height,
              sizes: lazy_sizes,
              widths: widths
          }}
        {% endif %}
      {% else %}
        {%- assign placeholder_image_index = forloop.index0 | modulo: 2 | plus: 1 -%}
        {%- assign placeholder_image = 'lifestyle-' | append: placeholder_image_index -%}
        {{
          placeholder_image
          | placeholder_svg_tag: 'placeholder-svg bg-light w-100  d-block d-md-none mobile-img-height opacity-50 bg-transparent'
        }}
      {% endif %}
    {% elsif block.settings.media_type == 'video' %}
      {% if block.settings.video_block != blank %}
        {{
          block.settings.video_block
          | video_tag: image_size: '1920x', class: 'object-fit-cover', width: '100%', height: '100%', autoplay: true, loop: true, controls: false, muted: true, playsinline: true
        }}
      {% else %}
        <video
          src="https://cdn.shopify.com/videos/c/o/v/fbb140fd46e3429eba459e1549dbbe38.mp4"
          width="100%"
          height="100%"
          autoplay
          loop
          muted
          playsinline
          class="object-fit-cover"
        ></video>
      {% endif %}
    {% endif %}
  </div>
  {% if block.settings.toggle_overlay %}
    {% render 'overlay', settings: block.settings %}
  {% endif %}

  <div class="{% if block.settings.full_width %}container-fluid{% else %}container{% endif %} banner-overlay img-height d-flex z-3 text-sm-{{ block.settings.content_alignment }} justify-content-center align-items-center {{ block.settings.box_align }}">
    <div
      class="content-block gap-style w-100 {% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %} {% if block.settings.bg_transparent == true %}bg-transparent{% endif %} d-flex flex-column {{  direction }} align-items-sm-{{ block.settings.content_alignment }}  spacing-style"
      {% if settings.animation != blank %}
        data-aos="{{ settings.animation}}"
      {% endif %}
      style="--content-width:{{ block.settings.desktop_content_width }}px; --gap-style:max(calc(var(--space-scale) * {{ block.settings.grid_space }}px)); {% render 'spacing-style', settings: block.settings %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:name.slide",
  "tag": null,
  "blocks": [{ "type": "text" },{"type": "description"}, { "type": "button" }],
  "settings": [
     {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": true
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.desktop_image",
      "info": "t:info.desktop_image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:settings.mobile_image",
      "info": "t:info.mobile_image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_block",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "t:settings.text_alignment_mobile",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "box_align",
      "options": [
        {
          "value": "justify-content-sm-start align-items-sm-start",
          "label": "t:options.top-left"
        },
        {
          "value": "justify-content-sm-center align-items-sm-start",
          "label": "t:options.top-center"
        },
        {
          "value": "justify-content-sm-end align-items-sm-start",
          "label": "t:options.top-right"
        },
        {
          "value": "justify-content-sm-start align-items-sm-center",
          "label": "t:options.middle-left"
        },
        {
          "value": "justify-content-sm-center align-items-sm-center",
          "label": "t:options.middle-center"
        },
        {
          "value": "justify-content-sm-end align-items-sm-center",
          "label": "t:options.middle-right"
        },
        {
          "value": "justify-content-sm-start align-items-sm-end",
          "label": "t:options.bottom-left"
        },
        {
          "value": "justify-content-sm-center align-items-sm-end",
          "label": "t:options.bottom-center"
        },
        {
          "value": "justify-content-sm-end align-items-sm-end",
          "label": "t:options.bottom-right"
        }
      ],
      "default": "justify-content-sm-center align-items-sm-center",
      "label": "t:settings.content_position"
    },
    {
      "type": "range",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 10,
      "unit": "px",
      "id": "grid_space",
      "label": "t:settings.gap"
    },
    {
      "type": "range",
      "min": 600,
      "max": 1000,
      "step": 10,
      "default": 600,
      "unit": "px",
      "id": "desktop_content_width",
      "label": "t:settings.content_width"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "bg_transparent",
      "label": "t:settings.bg_transparent",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Slide",
      "blocks": [
        {
          "type": "text",
          "name": "t:name.heading",
          "settings": {
            "text": "<h2>Your Headline Goes Here</h2>"
          }
        },
        {
          "type": "description",
          "name": "t:name.text",
          "settings": {
            "text": "  Your content goes here  "
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Button label"
          }
        }
      ]
    }
  ]
}
{% endschema %}
