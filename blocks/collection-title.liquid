<style>
  {% if placement == 'on_image' and block.settings.btn_style == 'btn-link' %}
    .collection-card :is(.section_block-{{ block.id }} .collection_title a, .collection-details > *) { color: rgb(var(--color-background)); }
    .collection-card :is(.section_block-{{ block.id }} .collection_title a):hover{ color: rgba(var(--bs-link-hover-color)); } 
  {% endif %}
</style>


{% liquid
  if block.settings.alignment == 'left'
    assign text_alignment = 'd-flex justify-content-start text-start'
  elsif block.settings.alignment == 'center'
    assign text_alignment = 'd-flex justify-content-center text-center'
  else
    assign text_alignment = 'd-flex justify-content-end text-end'
  endif

  assign collection = closest.collection
  assign count = block.settings.collection_count
%}

<div
  class="title_group section_block-{{ block.id }} spacing-style {% if block.settings.width != 'fit-content' %} {% endif %}"
  style="{% render 'spacing-style', settings: block.settings %}"
>
  <div
    class="collection_title position-relative  text-{{ block.settings.text_transform }} {{ block.settings.type_preset }} {% if block.settings.background %} text-bg-space {% endif %} m-0 text-wrap"
    {{ block.shopify_attributes }}
    style="{% if block.settings.background %} background:{{ block.settings.background_color | default: 'rgb(200 200 200 / 0.5)' }}; {% endif %}; {% render 'text-bg-space', settings: block.settings  %}"
  >
    {% if collection.title != blank %}
      <a href="{{ collection.url }}" class="collection-link {% if block.settings.btn_style != 'btn-link' %}btn {% endif %}{{ block.settings.btn_style }}">
        {{ collection.title }}
        {% if count %}
          <div class="collection_count position-absolute ">
            {%- if collection.all_products_count.size > 0 -%}
              <span>{{ 'sections.collection_list.count' | t: count: collection.all_products_count }}</span>
            {% else %}
              <span>{{ 'sections.collection_list.count' | t: count: 0 }}</span>
            {% endif %}
          </div>
        {% endif %}
      </a>
    {% else %}
      {{ 'sections.collection_list.title' | t }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:name.collection-title",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.collection_title"
    },
    {
      "type": "checkbox",
      "id": "collection_count",
      "label": "t:settings.collection_count"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:content.typography",
      "options": [
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "t:settings.testcase",
      "options": [
        {
          "value": "rte",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        },
        {
          "value": "capitalize",
          "label": "t:options.capitalize"
        },
        {
          "value": "lowercase",
          "label": "t:options.lowercase"
        }
      ],
      "default": "capitalize"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "t:settings.style",
      "default": "btn-link",
      "options": [
        {
          "value": "btn-primary",
          "label": "t:options.primary"
        },
        {
          "value": "btn-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "btn-link",
          "label": "t:options.link"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.collection-title",
      "category": "t:categories.collection",
      "settings": {}
    }
  ]
}
{% endschema %}
