{% liquid
  assign ratio = 1
  case block.settings.aspect_ratio
    when 'square'
      assign ratio = '1'
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'adapt'
      assign ratio = block.settings.image.aspect_ratio
  endcase
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1650, 1800, 1950, 2000, 2500, 3000, 3500, 4000, 5000'
%}
<style>
  .img-block-{{ block.id }} .image-block{
    aspect-ratio:{{ ratio }};
  }
  .img-block-{{ block.id }} .placeholder-image{
      aspect-ratio:{{ ratio }};
      height:100%;
      width:100%;
    }
</style>
<div
  class="spacing-style border-style  img-block img-block-{{ block.id }} overflow-hidden size-style w-100"
  style="{% render 'spacing-style', settings:block.settings %} {% render 'border-style', settings:block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
    {{
      block.settings.image
      | image_url: width: 3840
      | image_tag:
        width: block.settings.image.width,
        widths: widths,
        sizes: sizes,
        class: 'object-fit-cover image-block w-100 h-100'
    }}
    {% if block.settings.link != blank %}</a>{% endif %}
  {%- else -%}
    <div class="placeholder-image">
      {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg w-100 h-100' }}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:name.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:settings.size"
    },
    {
    "type": "select",
    "id": "aspect_ratio",
    "options": [
    {
    "value": "adapt",
    "label": "t:options.adapt",
    },
    {
    "value": "square",
    "label": "t:options.square",
    },
    {
    "value": "portrait",
    "label": "t:options.portrait",
    },
    {
    "value": "landscape",
    "label": "t:options.landscape",
    }
    ],
    "default": "square",
    "label": "t:name.aspect-ratio"
    },
    {
      "type": "header",
      "content": "t:name.border"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
"presets": [
    {
    "name": "t:name.image",
    "category": "t:categories.basic",
    }
  ]
}
{% endschema %}